{% extends "layouts/base.twig" %}
{% import "components/_icons.twig" as icons %}
{% block title %}{{ translations.new_complaint }}{% endblock %}

{% block head %}
<style>
    /* ── Pièces jointes ───────────────────────────────────────────────
       Prendre une photo est le geste principal de cet écran : on déclare
       un problème constaté en production, l'appareil est dans la main.
       Le déclencheur était pourtant une icône seule accolée au champ
       fichier — sans libellé, avec une cible d'environ 38 px de haut, et
       son intention cachée dans un title que le tactile n'affiche jamais.

       C'est maintenant un vrai bouton : pleine largeur, 54 px de haut,
       libellé explicite. Le champ fichier reste en dessous, en retrait,
       pour joindre un document déjà enregistré.
       ────────────────────────────────────────────────────────────────── */

    .att-slot {
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: var(--r-lg, 18px);
        background: var(--c-surface, #fff);
        padding: 14px;
        height: 100%;
    }
    .att-slot-lbl {
        font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
        color: var(--c-muted, #7a7168); margin-bottom: 10px;
    }

    .att-camera {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        width: 100%; min-height: 54px; padding: 0 18px;
        border: 0; border-radius: var(--r-md, 13px);
        background: var(--c-primary, #8D1D2C); color: #fff;
        font-family: inherit; font-size: .95rem; font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 18px -10px rgba(141,29,44,.6);
        transition: background .15s ease, transform .1s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .att-camera:hover { background: var(--c-primary-hover, #731722); color: #fff; }
    .att-camera:active { transform: scale(.985); }
    .att-camera i { font-size: 1.35rem; line-height: 1; }

    /* Le champ fichier est l'option secondaire : présent, mais discret. */
    .att-file-sep {
        display: flex; align-items: center; gap: 10px;
        margin: 12px 0 8px; font-size: .72rem; color: var(--c-muted, #7a7168);
    }
    .att-file-sep::before, .att-file-sep::after {
        content: ''; flex: 1; height: 1px; background: var(--c-line, rgba(36,26,22,.09));
    }

    .att-preview { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
    .att-preview img {
        width: 72px; height: 72px; object-fit: cover;
        border-radius: var(--r-sm, 9px); border: 1px solid var(--c-line, rgba(36,26,22,.09));
        flex-shrink: 0;
    }
    /* Retirer une photo : 44 px, comme toute cible tactile de l'app. */
    .att-remove {
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        min-height: 44px; padding: 0 16px;
        border: 1px solid rgba(141,29,44,.28); border-radius: var(--r-sm, 9px);
        background: #fff; color: var(--c-primary, #8D1D2C);
        font-family: inherit; font-size: .85rem; font-weight: 600; cursor: pointer;
    }
    .att-remove:active { background: rgba(141,29,44,.06); }

    /* Déclencheur de la modale : le geste conclusif mérite la même surface. */
    #capturePhotoBtn { min-height: 54px; font-size: 1rem; }

    /* ── Étapes ───────────────────────────────────────────────────────
       Le formulaire se dévoile étape par étape, mais rien ne le disait :
       quatre titres gris identiques, séparés d'un filet, avec un chiffre
       cerclé en 12 px. On ne savait ni où on en était, ni combien il
       restait. Chaque étape est maintenant une carte, numérotée pour de
       bon, avec son intitulé et sa raison d'être.
       ────────────────────────────────────────────────────────────────── */
    .cp-step {
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: var(--r-lg, 18px);
        background: var(--c-surface, #fff);
        box-shadow: var(--sh-2);
        margin-bottom: 14px;
        overflow: hidden;
    }
    .cp-step-head {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 15px 18px 13px;
        border-bottom: 1px solid var(--c-line, rgba(36,26,22,.09));
    }
    .cp-step-num {
        width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: var(--c-primary, #8D1D2C); color: #fff;
        font-family: var(--font-display); font-size: .9rem; line-height: 1;
    }
    .cp-step.is-wip .cp-step-num { background: rgba(36,26,22,.18); color: #fff; }
    .cp-step-titles { min-width: 0; flex: 1; }
    .cp-step-title { font-size: .98rem; font-weight: 700; color: var(--c-ink, #241f1c); line-height: 1.25; }
    .cp-step-sub { font-size: .78rem; color: var(--c-muted, #7a7168); margin-top: 2px; line-height: 1.4; }
    .cp-step-body { padding: 16px 18px; }

    /* Marqueur « à développer » — le bloc est visible pour situer le
       parcours à venir, mais rien n'y est saisissable. */
    .cp-wip-tag {
        display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0;
        font-size: .64rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
        color: #8a5a12; background: rgba(193,122,42,.16);
        border-radius: 999px; padding: 4px 10px; white-space: nowrap;
    }
    .cp-step.is-wip { opacity: .72; }
    .cp-step.is-wip .cp-step-body { pointer-events: none; }

    /* Scan du code QR — la voie rapide vers le produit, donc la plus visible. */
    .cp-scan {
        display: flex; align-items: center; justify-content: center; gap: 11px;
        width: 100%; min-height: 58px; padding: 0 18px;
        border: 1px dashed rgba(141,29,44,.4); border-radius: var(--r-md, 13px);
        background: rgba(141,29,44,.05); color: var(--c-primary, #8D1D2C);
        font-family: inherit; font-size: 1rem; font-weight: 600;
    }
    .cp-scan i { font-size: 1.5rem; line-height: 1; }
    .cp-scan-hint { font-size: .78rem; color: var(--c-muted, #7a7168); text-align: center; margin-top: 8px; }

    /* Barre d'action — la soumission ne doit pas se perdre en bas de page. */
    .cp-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
    .cp-submit {
        flex: 1 1 220px; min-height: 54px;
        display: inline-flex; align-items: center; justify-content: center; gap: 9px;
        border: 0; border-radius: var(--r-md, 13px);
        background: var(--c-primary, #8D1D2C); color: #fff;
        font-family: inherit; font-size: 1rem; font-weight: 600; cursor: pointer;
        box-shadow: 0 8px 18px -10px rgba(141,29,44,.6);
    }
    .cp-submit:hover { background: var(--c-primary-hover, #731722); color: #fff; }
    .cp-submit:active { transform: scale(.99); }
    .cp-cancel {
        flex: 0 1 auto; min-height: 54px; padding: 0 20px;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14)); border-radius: var(--r-md, 13px);
        background: #fff; color: var(--c-muted, #7a7168);
        font-size: .95rem; font-weight: 600; text-decoration: none;
    }
    .cp-cancel:hover { color: var(--c-ink, #241f1c); background: var(--c-bg-2, #F4EFE8); }
</style>
{% endblock %}
{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.new_complaint }}</h3>
        <p class="text-subtitle text-muted">{{ translations.complaints_subtitle }}</p>
    </div>
{% endblock %}
{% block content %}
{# Dane zamówień inline do obsługi JS #}
<script>
const deliveredOrders = {{ delivered_orders|json_encode|raw }};
</script>
<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        {% if errors is not empty %}
            <div class="alert alert-danger">{{ errors|join('<br>')|raw }}</div>
        {% endif %}
        {% if warnings is not empty %}
            <div class="alert alert-warning">{{ warnings|join('<br>')|raw }}</div>
        {% endif %}
        {% if delivered_orders is empty %}
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-3">{{ translations.no_delivered_orders }}</p>
                    <a href="{{ ROOT }}/complaints" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>{{ translations.back_to_complaints }}
                    </a>
                </div>
            </div>
        {% else %}
            {# Chaque étape est déjà une carte : la carte englobante d'avant
               les emboîtait les unes dans les autres, deux bordures et deux
               ombres pour une seule idée. Le formulaire porte directement les
               étapes. #}
            <form method="POST" enctype="multipart/form-data" id="complaintForm">
                            {# ── Scan du code QR — à développer ──
                               Placé avant le choix de la commande : à terme,
                               scanner l'étiquette identifiera le produit
                               directement, sans dérouler deux listes. Le bloc
                               est visible pour situer ce parcours, mais rien
                               n'y est saisissable tant qu'il n'existe pas. #}
                            <div class="cp-step is-wip">
                                <div class="cp-step-head">
                                    <span class="cp-step-num">{{ icons.svg('qr-code', 16) }}</span>
                                    <div class="cp-step-titles">
                                        <div class="cp-step-title">{{ translations.scan_qr }}</div>
                                        <div class="cp-step-sub">{{ translations.scan_qr_hint }}</div>
                                    </div>
                                    <span class="cp-wip-tag">
                                        <i class="bi bi-tools"></i>{{ translations.to_be_developed }}
                                    </span>
                                </div>
                                <div class="cp-step-body">
                                    <button type="button" class="cp-scan" disabled>
                                        {{ icons.svg('qr-code', 26) }}
                                        <span>{{ translations.scan_qr }}</span>
                                    </button>
                                </div>
                            </div>

                            {# Étape 1 : commande livrée #}
                            <div class="cp-step">
                                <div class="cp-step-head">
                                    <span class="cp-step-num">1</span>
                                    <div class="cp-step-titles">
                                        <div class="cp-step-title">{{ translations.delivered_order }}</div>
                                        <div class="cp-step-sub">{{ translations.select_order }}</div>
                                    </div>
                                </div>
                                <div class="cp-step-body">
                                    <label class="form-label" for="order_select">{{ translations.delivered_order }}</label>
                                    <select class="form-select" id="order_select" required>
                                        <option value="">{{ translations.select_order }}</option>
                                        {% for order in delivered_orders %}
                                            <option value="{{ order.id }}">
                                                {{ order.order_key }} — {{ order.delivered_on|default('') }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <input type="hidden" name="id_order" id="id_order">
                                </div>
                            </div>

                            {# Étape 2 : produit et quantité #}
                            <div class="cp-step" id="productSection" style="display:none;">
                                <div class="cp-step-head">
                                    <span class="cp-step-num">2</span>
                                    <div class="cp-step-titles">
                                        <div class="cp-step-title">{{ translations.product_name }}</div>
                                        <div class="cp-step-sub">{{ translations.select_material }}</div>
                                    </div>
                                </div>
                                <div class="cp-step-body">
                                    <div class="row g-3">
                                        <div class="col-12 col-md-7">
                                            <label class="form-label" for="material_select">{{ translations.product_name }}</label>
                                            <select class="form-select" id="material_select">
                                                <option value="">{{ translations.select_material }}</option>
                                            </select>
                                            <input type="hidden" name="id_material"   id="id_material">
                                            <input type="hidden" name="supplier_sku"  id="supplier_sku">
                                            <input type="hidden" name="id_unit"       id="id_unit">
                                        </div>
                                        <div class="col-12 col-md-5" id="qtySection" style="display:none;">
                                            <label class="form-label" for="product_quantity">
                                                {{ translations.complaint_quantity }}
                                                <span class="text-muted" id="qtyMaxLabel"></span>
                                            </label>
                                            <input type="number" class="form-control" id="product_quantity"
                                                   name="product_quantity" value="1" min="1" step="0.01">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# ── Livraison et péremption — à développer ──
                               Deux informations que le magasin a sous les yeux
                               au moment de constater le défaut, et qui manquent
                               aujourd'hui au fournisseur pour instruire le
                               dossier. Les champs sont désactivés : désactivés,
                               ils ne sont pas soumis, donc rien ne part vers
                               une API qui ne les attend pas encore. #}
                            <div class="cp-step is-wip" id="lotSection" style="display:none;">
                                <div class="cp-step-head">
                                    <span class="cp-step-num">{{ icons.svg('package', 16) }}</span>
                                    <div class="cp-step-titles">
                                        <div class="cp-step-title">
                                            {{ translations.delivery }} · {{ translations.expiry_date }}
                                        </div>
                                        <div class="cp-step-sub">{{ translations.optional }}</div>
                                    </div>
                                    <span class="cp-wip-tag">
                                        <i class="bi bi-tools"></i>{{ translations.to_be_developed }}
                                    </span>
                                </div>
                                <div class="cp-step-body">
                                    <div class="row g-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="delivery_ref">{{ translations.delivery }}</label>
                                            <input type="text" class="form-control" id="delivery_ref" disabled>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="expiry_date">{{ translations.expiry_date }}</label>
                                            <input type="date" class="form-control" id="expiry_date" disabled>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Étape 3 : motif et description #}
                            <div class="cp-step" id="reasonSection" style="display:none;">
                                <div class="cp-step-head">
                                    <span class="cp-step-num">3</span>
                                    <div class="cp-step-titles">
                                        <div class="cp-step-title">{{ translations.complaint_reason }}</div>
                                        <div class="cp-step-sub">{{ translations.description }}</div>
                                    </div>
                                </div>
                                <div class="cp-step-body">
                                    <div class="row g-3">
                                        <div class="col-12 col-md-5">
                                            <label class="form-label" for="complaint_reason_code">{{ translations.complaint_reason }}</label>
                                            <select class="form-select" id="complaint_reason_code" name="complaint_reason_code">
                                                {% for reason in complaint_reasons %}
                                                    <option value="{{ reason.code ?? reason.getCode() }}">
                                                        {{ reason.name ?? reason.getName() }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-7">
                                            <label class="form-label" for="description">{{ translations.description }}</label>
                                            <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Étape 4 : pièces jointes #}
                            <div class="cp-step" id="attachmentSection" style="display:none;">
                                <div class="cp-step-head">
                                    <span class="cp-step-num">4</span>
                                    <div class="cp-step-titles">
                                        <div class="cp-step-title">{{ translations.attachments }}</div>
                                        <div class="cp-step-sub">{{ translations.attachment }} 1-2 · {{ translations.optional }}</div>
                                    </div>
                                </div>
                                <div class="cp-step-body">
                                <div class="row">
                                {% for slot in [1, 2] %}
                                    <div class="col-12 col-md-6 mb-3">
                                        <div class="att-slot">
                                            <div class="att-slot-lbl">{{ translations.attachment }} {{ slot }}</div>

                                            <button type="button" class="att-camera camera-btn" data-slot="{{ slot }}">
                                                <i class="bi bi-camera"></i>
                                                <span>{{ translations.take_photo ?? 'Prendre une photo' }}</span>
                                            </button>

                                            <div class="att-file-sep">{{ translations.or ?? 'ou' }}</div>

                                            <label class="visually-hidden" for="attachments_{{ slot }}">
                                                {{ translations.attachment }} {{ slot }}
                                            </label>
                                            <input class="form-control form-control-sm" type="file"
                                                   id="attachments_{{ slot }}" name="attachments[]"
                                                   accept=".jpg,.jpeg,.png,.pdf,.doc,.docx">

                                            <div id="cameraPreview_{{ slot }}" class="att-preview" style="display:none;">
                                                <img id="capturedImg_{{ slot }}" alt="">
                                                <button type="button" class="att-remove remove-photo-btn" data-slot="{{ slot }}">
                                                    <i class="bi bi-trash"></i>
                                                    <span>{{ translations.remove ?? 'Retirer' }}</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                                </div>
                                </div>
                            </div>

                            {# Modal kamery #}
                            <div class="modal fade" id="cameraModal" tabindex="-1" aria-labelledby="cameraModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="cameraModalLabel">
                                                <i class="bi bi-camera me-2"></i>{{ translations.take_photo | default("Prendre la photo") }}
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-center p-2">
                                            {# Wybór kamery (jeśli dostępnych jest więcej) #}
                                            <div id="cameraSelectorWrapper" class="mb-2" style="display:none;">
                                                <select class="form-select form-select-sm" id="cameraDeviceSelect">
                                                </select>
                                            </div>
                                            <video id="cameraVideo" autoplay playsinline
                                                   style="width:100%;max-height:55vh;border-radius:8px;background:#000;"></video>
                                            <canvas id="cameraCanvas" style="display:none;"></canvas>
                                            <div id="cameraError" class="alert alert-danger mt-2" style="display:none;"></div>
                                        </div>
                                        <div class="modal-footer justify-content-center">
                                            <button type="button" class="btn btn-outline-secondary" id="switchCameraBtn" style="display:none;">
                                                <i class="bi bi-arrow-repeat me-1"></i>{{ translations.switch_camera | default("Changer de caméra") }}
                                            </button>
                                            <button type="button" class="btn btn-primary px-5" id="capturePhotoBtn">
                                                <i class="bi bi-circle-fill me-1"></i>{{ translations.capture | default("Déclencher") }}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {# Actions — visibles une fois le produit choisi.
                               Le bouton d'envoi conclut le parcours : il prend
                               la largeur et la même hauteur que les autres
                               gestes de la page. #}
                            <div id="submitSection" style="display:none;">
                                <div class="cp-actions">
                                    <button type="submit" class="cp-submit" id="submit_complaint">
                                        <i class="bi bi-send"></i>{{ translations.submit_complaint }}
                                    </button>
                                    <a href="{{ ROOT }}/complaints" class="cp-cancel">
                                        <i class="bi bi-arrow-left"></i>{{ translations.back_to_complaints }}
                                    </a>
                                </div>
                            </div>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
    const orderSelect   = document.getElementById('order_select');
    const materialSelect = document.getElementById('material_select');
    const idOrderInput  = document.getElementById('id_order');
    const idMaterialInput = document.getElementById('id_material');
    const supplierSkuInput = document.getElementById('supplier_sku');
    const idUnitInput   = document.getElementById('id_unit');
    const qtyInput      = document.getElementById('product_quantity');
    const qtyMaxLabel   = document.getElementById('qtyMaxLabel');
    const productSection    = document.getElementById('productSection');
    const qtySection        = document.getElementById('qtySection');
    const reasonSection     = document.getElementById('reasonSection');
    const attachmentSection = document.getElementById('attachmentSection');
    const submitSection     = document.getElementById('submitSection');
    const lotSection        = document.getElementById('lotSection');
    function showProductSections() {
        productSection.style.display    = '';
        reasonSection.style.display     = '';
        attachmentSection.style.display = '';
        submitSection.style.display     = '';
        // Bloc livraison / péremption : encore à développer, mais il suit le
        // même dévoilement que les autres pour que le parcours reste lisible.
        if (lotSection) lotSection.style.display = '';
    }
    function hideProductDetail() {
        qtySection.style.display = 'none';
        idMaterialInput.value = '';
        supplierSkuInput.value = '';
        idUnitInput.value = '';
        qtyInput.value = '1';
        qtyInput.removeAttribute('max');
        qtyMaxLabel.textContent = '';
    }
    // Zmiana zamówienia – populuj listę produktów
    orderSelect.addEventListener('change', function () {
        const orderId = this.value;
        idOrderInput.value = orderId;
        materialSelect.innerHTML = '<option value="">{{ translations.select_material|escape("js") }}</option>';
        hideProductDetail();
        if (!orderId) {
            productSection.style.display    = 'none';
            reasonSection.style.display     = 'none';
            attachmentSection.style.display = 'none';
            submitSection.style.display     = 'none';
            return;
        }
        const order = deliveredOrders.find(o => String(o.id) === String(orderId));
        if (!order || !order.products || order.products.length === 0) {
            showProductSections();
            return;
        }
        order.products.forEach(function (p) {
            const maxQty = ((p.pack_quantity ?? 0) * (p.pack_size_in_base_unit ?? 1));
            const opt = document.createElement('option');
            opt.value        = p.id_material;
            opt.dataset.sku  = p.supplier_sku   ?? '';
            opt.dataset.unit = p.id_unit        ?? '';
            opt.dataset.unitName = p.unit_name  ?? '';
            opt.dataset.max  = maxQty;
            opt.textContent  = `${p.material_name}${p.supplier_sku ? ' (' + p.supplier_sku + ')' : ''}`;
            materialSelect.appendChild(opt);
        });
        showProductSections();
    });
    // Zmiana produktu – uzupełnij pola ukryte i max ilości
    materialSelect.addEventListener('change', function () {
        const opt = this.options[this.selectedIndex];
        hideProductDetail();
        if (!this.value) return;
        idMaterialInput.value  = this.value;
        supplierSkuInput.value = opt.dataset.sku  ?? '';
        idUnitInput.value      = opt.dataset.unit ?? '';
        const maxQty  = parseFloat(opt.dataset.max  ?? 0);
        const unitName = opt.dataset.unitName ?? '';
        qtyInput.max   = maxQty > 0 ? maxQty : '';
        qtyInput.value = 1;
        if (maxQty > 0) {
            qtyMaxLabel.textContent = `(max. ${maxQty}${unitName ? ' ' + unitName : ''})`;
        }
        qtySection.style.display = '';
    });
    // ===================== KAMERA =====================
    (function () {
        let currentStream  = null;
        let currentSlot    = null;
        let videoDevices   = [];
        let currentDeviceIndex = 0;
        // Przechowuje pliki zrobionych zdjęć per slot (poza file inputem)
        const capturedFiles = {};

        const video            = document.getElementById('cameraVideo');
        const canvas           = document.getElementById('cameraCanvas');
        const cameraError      = document.getElementById('cameraError');
        const captureBtn       = document.getElementById('capturePhotoBtn');
        const switchBtn        = document.getElementById('switchCameraBtn');
        const deviceSelect     = document.getElementById('cameraDeviceSelect');
        const selectorWrapper  = document.getElementById('cameraSelectorWrapper');
        const modalEl          = document.getElementById('cameraModal');

        if (!modalEl) return;

        // Bootstrap modal instance
        const bsModal = new bootstrap.Modal(modalEl);

        async function enumerateDevices() {
            try {
                const devices  = await navigator.mediaDevices.enumerateDevices();
                videoDevices   = devices.filter(d => d.kind === 'videoinput');
                deviceSelect.innerHTML = '';
                videoDevices.forEach((d, i) => {
                    const opt = document.createElement('option');
                    opt.value = i;
                    opt.textContent = d.label || ('Kamera ' + (i + 1));
                    deviceSelect.appendChild(opt);
                });
                if (videoDevices.length > 1) {
                    selectorWrapper.style.display = '';
                    switchBtn.style.display = '';
                } else {
                    selectorWrapper.style.display = 'none';
                    switchBtn.style.display = 'none';
                }
            } catch {}
        }

        async function startCamera(deviceIndex) {
            stopCamera();
            cameraError.style.display = 'none';
            const constraints = {
                video: videoDevices.length > 0
                    ? { deviceId: { exact: videoDevices[deviceIndex].deviceId }, facingMode: 'environment' }
                    : { facingMode: 'environment' },
                audio: false
            };
            try {
                currentStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = currentStream;
                currentDeviceIndex = deviceIndex;
                if (deviceSelect) deviceSelect.value = deviceIndex;
            } catch (err) {
                cameraError.style.display = '';
                cameraError.textContent = {{ (translations.camera_denied | default("Caméra inaccessible : ")) | json_encode | raw }} + err.message;
            }
        }

        function stopCamera() {
            if (currentStream) {
                currentStream.getTracks().forEach(t => t.stop());
                currentStream = null;
            }
            video.srcObject = null;
        }

        // Otwieranie modala
        document.querySelectorAll('.camera-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                currentSlot = this.dataset.slot;
                await enumerateDevices();
                // Preferuj tylną kamerę na tablecie
                const backIdx = videoDevices.findIndex(d =>
                    d.label.toLowerCase().includes('back') ||
                    d.label.toLowerCase().includes('rear') ||
                    d.label.toLowerCase().includes('environment')
                );
                await startCamera(backIdx >= 0 ? backIdx : 0);
                bsModal.show();
            });
        });

        // Przełączanie kamery
        if (switchBtn) {
            switchBtn.addEventListener('click', async function () {
                const nextIndex = (currentDeviceIndex + 1) % videoDevices.length;
                await startCamera(nextIndex);
            });
        }

        // Zmiana kamery z selecta
        if (deviceSelect) {
            deviceSelect.addEventListener('change', async function () {
                await startCamera(parseInt(this.value));
            });
        }

        // Zrobienie zdjęcia
        if (captureBtn) {
            captureBtn.addEventListener('click', function () {
                if (!currentStream) return;
                canvas.width  = video.videoWidth;
                canvas.height = video.videoHeight;
                canvas.getContext('2d').drawImage(video, 0, 0);
                canvas.toBlob(function (blob) {
                    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
                    const file = new File([blob], 'photo_' + timestamp + '.jpg', { type: 'image/jpeg' });
                    // Przypisz plik do właściwego inputa przez DataTransfer
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    const fileInput = document.getElementById('attachments_' + currentSlot);
                    if (fileInput) {
                        fileInput.files = dt.files;
                    }
                    // Pokaż podgląd
                    const previewDiv = document.getElementById('cameraPreview_' + currentSlot);
                    const previewImg = document.getElementById('capturedImg_' + currentSlot);
                    if (previewDiv && previewImg) {
                        previewImg.src = canvas.toDataURL('image/jpeg');
                        previewDiv.style.display = '';
                    }
                    stopCamera();
                    bsModal.hide();
                }, 'image/jpeg', 0.92);
            });
        }

        // Zatrzymaj kamerę przy zamykaniu modala
        modalEl.addEventListener('hidden.bs.modal', function () {
            stopCamera();
        });

        // Usuwanie zrobionych zdjęć
        document.querySelectorAll('.remove-photo-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const slot = this.dataset.slot;
                const fileInput = document.getElementById('attachments_' + slot);
                if (fileInput) {
                    fileInput.value = '';
                    // Reset przez DataTransfer
                    try {
                        const dt = new DataTransfer();
                        fileInput.files = dt.files;
                    } catch {}
                }
                const previewDiv = document.getElementById('cameraPreview_' + slot);
                const previewImg = document.getElementById('capturedImg_' + slot);
                if (previewDiv) previewDiv.style.display = 'none';
                if (previewImg) previewImg.src = '';
            });
        });
    })();
    // ===================== KONIEC KAMERY =====================

    // Walidacja i spinner przy submit
    const form      = document.getElementById('complaintForm');
    const submitBtn = document.getElementById('submit_complaint');
    if (form && submitBtn) {
        form.addEventListener('submit', function (e) {
            // Walidacja wymaganego zamówienia
            if (!idOrderInput.value) {
                e.preventDefault();
                alert('{{ translations.select_order|escape("js") }}');
                orderSelect.focus();
                return;
            }
            // Walidacja wymaganego produktu
            if (!idMaterialInput.value) {
                e.preventDefault();
                alert('{{ translations.select_material|escape("js") }}');
                materialSelect.focus();
                return;
            }
            // Walidacja ilości
            const maxQty    = parseFloat(qtyInput.max);
            const enteredQty = parseFloat(qtyInput.value);
            if (isNaN(enteredQty) || enteredQty < 0.01 || (maxQty > 0 && enteredQty > maxQty)) {
                e.preventDefault();
                alert('{{ translations.invalid_quantity_message|escape("js") }}');
                qtyInput.focus();
                return;
            }
            // Spinner
            submitBtn.disabled = true;
            if (!document.getElementById('submit-spinner')) {
                const spinner = document.createElement('span');
                spinner.className = 'spinner-border spinner-border-sm ms-2';
                spinner.setAttribute('role', 'status');
                spinner.setAttribute('aria-hidden', 'true');
                spinner.id = 'submit-spinner';
                submitBtn.appendChild(spinner);
            }
        });
    }
})();
</script>
{% endblock %}
