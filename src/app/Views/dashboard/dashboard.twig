{% extends "layouts/base.twig" %}
{% block title %}{{ translations.kitchen_dashboard }}{% endblock %}
{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.kitchen_dashboard }}</h3>
        <p class="text-subtitle text-muted">{{ translations.kitchen_dashboard_subtitle }}</p>
    </div>
{% endblock %}
{% block content %}
    {# alerty globalne (wg Twojego wzorca) #}
    {% include "page_components/alerts.twig" %}
    <div class="row">
        {# QUICK ACTIONS #}
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">{{ translations.quick_actions }}</h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        {# === PRODUKCJA – W TRAKCIE BUDOWY === #}
                        <div class="col-12 col-md-3">
                            <div class="card border shadow-sm h-100 text-decoration-none position-relative"
                                 style="opacity:.65; cursor:not-allowed;">
                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2"
                                      style="font-size:.7rem; z-index:1;">
                                    <i class="bi bi-tools me-1"></i>{{ translations.under_construction|default('W budowie') }}
                                </span>
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-secondary">
                                            <i class="bi bi-list-check text-muted"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-muted">{{ translations.todays_production }}</h5>
                                        <div class="text-muted small">{{ translations.todays_production_subtitle }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {# === SOP – les standards du réseau, sur la tablette Formation du cockpit === #}
                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/sop" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-danger">
                                            <i class="bi bi-mortarboard"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.sop|default('SOP') }}</h5>
                                        <div class="text-muted small">{{ translations.sop_subtitle|default('') }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        {# === KARTY PRODUKCYJNE – podpięte pod /knowledge/products === #}
                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/knowledge/products" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-success">
                                            <i class="bi bi-journal-text"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.production_cards }}</h5>
                                        <div class="text-muted small">{{ translations.production_cards_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        {# === CHECKLISTY – działa === #}
                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/checklists" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-warning">
                                            <i class="bi bi-clipboard-check"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.checklists }}</h5>
                                        <div class="text-muted small">{{ translations.checklists_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        {# === ZAMÓWIENIA – działa === #}
                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/orders" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-info">
                                            <i class="bi bi-truck"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.my_orders }}</h5>
                                        <div class="text-muted small">{{ translations.my_orders_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STATS – dane z checklist na dzień dzisiejszy #}
        <div class="col-12">
            <div class="row g-3">
                <div class="col-12">
                    <p class="text-muted small mb-1">
                        <i class="bi bi-info-circle me-1"></i>
                        {{ translations.stats_from_checklists|default('Statystyki oparte o checklisty z dnia dzisiejszego') }}
                    </p>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-muted small">{{ translations.tasks_todo }}</div>
                                <div class="fs-3 fw-bold">{{ stats.tasks_todo|default(0) }}</div>
                            </div>
                            <i class="bi bi-circle fs-2 text-muted"></i>
                        </div>
                    </div>
                </div>
                {# tasks_in_progress – W TRAKCIE BUDOWY (brak rozróżnienia statusów w API) #}
                <div class="col-12 col-md-4">
                    <div class="card h-100 border-warning" style="opacity:.7;">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted small">{{ translations.tasks_in_progress }}</span>
                                    <span class="badge bg-warning text-dark" style="font-size:.65rem;">
                                        <i class="bi bi-tools"></i> {{ translations.under_construction|default('W budowie') }}
                                    </span>
                                </div>
                                <div class="fs-3 fw-bold text-muted">–</div>
                            </div>
                            <i class="bi bi-arrow-repeat fs-2 text-muted"></i>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-muted small">{{ translations.tasks_completed }}</div>
                                <div class="fs-3 fw-bold">{{ stats.tasks_completed|default(0) }}</div>
                            </div>
                            <i class="bi bi-check-circle fs-2 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# BAZA WIEDZY – skrót #}
        <div class="col-12 mt-2">
            <div class="card border-0 bg-light">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-book fs-4 text-primary"></i>
                            <div>
                                <div class="fw-semibold">{{ translations.knowledge|default('Baza wiedzy') }}</div>
                                <div class="text-muted small">{{ translations.knowledge_overview_subtitle|default('Karty techniczne produktów i przepisy') }}</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ ROOT }}/knowledge/products" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-box-seam me-1"></i>{{ translations.products|default('Produkty') }}
                            </a>
                            <a href="{{ ROOT }}/knowledge" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-grid me-1"></i>{{ translations.knowledge|default('Przegląd') }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
