<!DOCTYPE html>
<html lang="{{ lang_code ?? 'fr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Error{% endblock %}</title>

    {# Pas de police distante ici non plus — voir layouts/base.twig. Une page
       d'erreur qui met treize secondes à s'afficher serait la pire des pages
       d'erreur : elle passerait pour la panne qu'elle est censée expliquer. #}
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/bootstrap.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/app.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/atelier-theme.css">
    <link rel="shortcut icon" href="{{ ROOT }}/assets/images/favicon.svg" type="image/x-icon">

    <style>
        body {
            background-color: #F4EFE8;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .merr-wrap {
            text-align: center;
            padding: 2rem 1.5rem;
            max-width: 480px;
            width: 100%;
        }
        .merr-code {
            font-size: 5.5rem;
            font-weight: 800;
            line-height: 1;
            color: #8D1D2C;
            letter-spacing: .04em;
            margin-bottom: 1.25rem;
        }
        .merr-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: 0.5rem;
        }
        .merr-subtitle {
            color: #6c757d;
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
        }
        .merr-actions {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="merr-wrap">
        {% block illustration %}{% endblock %}

        <div class="merr-title">{% block error_title %}Error{% endblock %}</div>
        <div class="merr-subtitle">{% block error_subtitle %}{% endblock %}</div>

        <div class="merr-actions">
            {% block actions %}
                {# « ROOT » nu ne correspond à aucune route : le bouton de secours
                   renvoyait donc sur la page qu'il devait quitter. On vise
                   l'accueil DU MODE — en WebShop, le tableau de bord cuisine
                   n'existe pas au menu. #}
                <a href="{{ ROOT }}{{ mode_home | default('/dashboard') }}" class="btn btn-outline-primary btn-lg w-100">
                    <i class="bi bi-house me-1"></i>
                    {{ translations.go_home ?? 'Go to home' }}
                </a>
            {% endblock %}
        </div>

        {% block footer %}{% endblock %}
    </div>

    <script src="{{ ROOT }}/assets/js/bootstrap.bundle.min.js"></script>
</body>
</html>
