{% extends "layouts/base.twig" %}

{% block title %}{{ translations.knowledge_overview|default('Knowledge') }}{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.knowledge_overview|default('Knowledge') }}</h3>
        <p class="text-subtitle text-muted">{{ translations.knowledge_overview_subtitle|default("Parcourez les ressources de connaissances de l'entreprise - produits et sous-recettes.") }}</p>

        {# Breadcrumb to show user's location #}
    </div>
{% endblock %}

{% block content %}

    {# alerty globalne (wg Twojego wzorca) #}
    {% include "page_components/alerts.twig" %}

    <div class="row">

        {# KNOWLEDGE NAVIGATION - główny panel nawigacyjny do zasobów wiedzy #}
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">{{ translations.knowledge_navigation }}</h4>
                </div>
                <div class="card-body">
                    <div class="row g-4">

                        {# ── La carte « Sous-recettes » a été retirée ──
                           Elle pointait sur /knowledge/recipes, une URL sans
                           route : le clic rendait une page blanche. Et la route
                           n'aurait rien réparé — knowledge/recipe/overview.twig
                           est un fichier vide.

                           Le contrôleur, le service et le dépôt des sous-recettes
                           restent en place, prêts à servir : il manque l'écran.
                           Tant qu'il manque, mieux vaut ne rien promettre que
                           d'ouvrir sur du vide. Remettre la carte le jour où le
                           gabarit existe, avec la route dans KnowledgeRoutes. #}

                        <div class="col-12 col-lg-6">
                            <a href="{{ ROOT }}/knowledge/products" class="card border-2 border-success shadow-sm h-100 text-decoration-none hover-lift">
                                <div class="card-body p-4">
                                    <div class="d-flex gap-3 align-items-start mb-3">
                                        <div class="avatar avatar-xl">
                                            <span class="avatar-content bg-success">
                                                <i class="bi bi-box-seam fs-3 text-white"></i>
                                            </span>
                                        </div>
                                        <div>
                                            <h4 class="mb-2 text-dark">{{ translations.products }}</h4>
                                            <p class="text-muted mb-0">{{ translations.products_subtitle }}</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center text-success">
                                        <span class="fw-semibold">{{ translations.go_to_products|default('Go to products') }}</span>
                                        <i class="bi bi-arrow-right ms-2"></i>
                                    </div>
                                </div>
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}
