{% extends "layouts/base.twig" %}

{% block title %}{{ product.getName() }} – {{ translations.technical_sheet|default('Karta techniczna') }}{% endblock %}

{% block head %}
<style>
    /* ===== KARTA TECHNICZNA PRODUKTU ===== */
    .fiche-wrap {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
    }

    /* --- RETOUR --- */
    .fiche-back {
        display: inline-flex; align-items: center; gap: 8px;
        min-height: 44px; padding: 0 16px 0 12px;
        margin-bottom: 12px;
        border: 1px solid rgba(141,29,44,.3);
        border-radius: var(--r-pill, 999px);
        background: rgba(141,29,44,.06);
        color: var(--c-primary, #8D1D2C);
        font-size: .9rem; font-weight: 600; text-decoration: none;
        transition: background .15s ease, border-color .15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .fiche-back:hover {
        background: rgba(141,29,44,.12); border-color: rgba(141,29,44,.5);
        color: var(--c-primary, #8D1D2C);
    }
    .fiche-back:active { transform: scale(.98); }
    .fiche-back i { font-size: 1.05rem; line-height: 1; }

    /* --- PHOTO EN TÊTE --- */
    .fiche-hero {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        /* Bornée : en 16/9 pleine largeur sur une tablette en paysage, elle
           ferait 600 px et repousserait la fiche entière sous la ligne de
           flottaison. On veut voir l'image ET commencer à lire. */
        max-height: 42vh;
        background: repeating-linear-gradient(45deg, #f2ece4 0 14px, #ece5da 14px 28px);
        border-bottom: 1px solid #dee2e6;
        overflow: hidden;
        display: flex; align-items: center; justify-content: center;
    }
    .fiche-hero img { width: 100%; height: 100%; object-fit: cover; display: block; cursor: zoom-in; }
    .fiche-hero-empty {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        color: #b9ada0;
    }
    .fiche-hero-empty i { font-size: 2.6rem; }
    .fiche-hero-empty span { font-size: .85rem; }
    /* Repère d'agrandissement : sans lui, rien ne dit que la photo s'ouvre. */
    .fiche-hero-zoom {
        position: absolute; right: 12px; bottom: 12px;
        width: 38px; height: 38px; border-radius: 50%;
        background: rgba(255,255,255,.92); color: #241f1c;
        display: flex; align-items: center; justify-content: center;
        font-size: .9rem; box-shadow: 0 4px 12px -6px rgba(0,0,0,.5);
        pointer-events: none;
    }

    /* --- HEADER --- */
    .fiche-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px 24px;
        border-bottom: 1px solid #dee2e6;
        gap: 20px;
    }
    .fiche-header-left { flex: 1; }
    .fiche-category-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6c757d;
        margin-bottom: 4px;
    }
    .fiche-product-name {
        font-size: 1.9rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 4px;
        line-height: 1.2;
    }
    .fiche-product-desc {
        color: #6c757d;
        font-size: 0.88rem;
        margin-bottom: 10px;
    }
    .fiche-badges { display: flex; flex-wrap: wrap; gap: 6px; }
    .fiche-badge {
        display: inline-block;
        padding: 3px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 4px;
    }
    .fiche-badge-dlc  { background: #fff3cd; color: #856404; }
    .fiche-badge-price { background: #d1e7dd; color: #0f5132; }
    .fiche-badge-veg   { background: #d1e7dd; color: #0f5132; }
    .fiche-badge-prep  { background: #fff3cd; color: #856404; }
    .fiche-badge-nutri { background: #e7f1ff; color: #0a58ca; }
    .fiche-badge-label { background: #f0f0f0; color: #333; }

    .fiche-header-photo {
        width: 180px;
        min-width: 180px;
        height: 130px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        font-size: 0.8rem;
        position: relative;
        overflow: hidden;
    }
    .fiche-header-photo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 6px;
    }
    .fiche-photo-label {
        position: absolute;
        bottom: 6px;
        left: 6px;
        background: rgba(0,0,0,0.55);
        color: #fff;
        padding: 2px 7px;
        font-size: 0.65rem;
        font-weight: 700;
        border-radius: 3px;
        letter-spacing: 0.04em;
    }

    /* --- MAIN 2-KOLUMNY --- */
    /* ── Corps de la fiche ──
       Une seule colonne, à toutes les largeurs. La fiche se lit alors dans
       un ordre unique — composition, allergènes, stockage, préparation —
       le même quel que soit l'écran et quelles que soient les sections
       présentes. Deux colonnes obligeaient l'œil à choisir un côté, et
       laissaient la droite vide sur les produits sans étapes. */
    .fiche-main { display: block; }
    .fiche-sec { padding: 20px 24px; min-width: 0; }
    .fiche-sec + .fiche-sec { border-top: 1px solid #dee2e6; }

    /* Repli des données de gestion */
    .fiche-admin { margin-top: 14px; }
    .fiche-admin > summary {
        cursor: pointer; list-style: none;
        font-size: .78rem; font-weight: 600; color: #8a8178;
        padding: 9px 0; min-height: 40px;
        display: flex; align-items: center; gap: 7px;
    }
    .fiche-admin > summary::-webkit-details-marker { display: none; }
    .fiche-admin > summary::before { content: '⌄'; font-size: 1rem; line-height: 1; }
    .fiche-admin[open] > summary::before { content: '⌃'; }

    /* --- SECTION TITLE --- */
    .fiche-section-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
        margin-bottom: 10px;
        padding-bottom: 5px;
        border-bottom: 1px solid #e9ecef;
        margin-top: 18px;
    }
    .fiche-section-title:first-child { margin-top: 0; }

    /* --- SKŁAD – chipy --- */
    .ingredient-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .ingredient-chip {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        padding: 3px 10px;
        font-size: 0.78rem;
        border-radius: 4px;
        color: #212529;
    }
    .ingredient-chip.subrecipe {
        background: #fff8e1;
        border-color: #ffe082;
        font-weight: 600;
    }
    .ingredient-chip.has-allergen {
        background: #fdeaea;
        border-color: #f5c2c7;
        color: #842029;
    }

    /* --- ALERGENY --- */
    .allergen-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .allergen-chip {
        padding: 3px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 4px;
        background: #fdeaea;
        color: #842029;
        border: 1px solid #f5c2c7;
    }
    .allergen-note {
        font-size: 0.78rem;
        color: #6c757d;
        font-style: italic;
    }

    /* --- NOTATKA STORAGE/PODGRZEWANIE --- */
    .fiche-note-box {
        background: #fff3cd;
        border-left: 3px solid #ffc107;
        padding: 10px 14px;
        border-radius: 0 4px 4px 0;
    }
    .fiche-note-box p { font-size: 0.82rem; color: #664d03; line-height: 1.5; margin: 0; }
    .fiche-info-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.83rem;
    }
    .fiche-info-row:last-child { border-bottom: none; }
    .fiche-info-label { color: #6c757d; min-width: 160px; }
    .fiche-info-value { font-weight: 600; color: #212529; }

    /* --- KROKI PRZYGOTOWANIA --- */
    .fiche-step {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.86rem;
        color: #212529;
        line-height: 1.5;
    }
    .fiche-step:last-child { border-bottom: none; }

    /* --- PARCOURS DE PRÉPARATION ---
       Le texte du geste porte la lecture ; la durée, le four et le batch sont
       des conditions, en retrait sous lui. Les mettre sur la même ligne que
       l'instruction ferait hésiter entre lire et calculer. */
    .prep-step-body { min-width: 0; flex: 1; }
    .prep-total {
        float: right; text-transform: none; letter-spacing: 0;
        font-weight: 700; color: var(--c-encre, #1F4F6B);
    }
    .prep-step-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
    .prep-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: var(--r-pill, 999px);
        background: #f4efe8; border: 1px solid #e4dbcf;
        font-size: .74rem; font-weight: 600; color: #6b6259;
        white-space: nowrap;
    }
    .prep-chip i { font-size: .82rem; line-height: 1; }
    /* Le four est la contrainte qui décide de la cadence : il se repère sans
       être lu. */
    .prep-chip.is-oven {
        background: rgba(193,122,42,.12); border-color: rgba(193,122,42,.35);
        color: #8a5518;
    }
    .prep-step-shots { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 9px; }
    .prep-shot {
        width: 104px; aspect-ratio: 4 / 3; object-fit: cover;
        border-radius: 6px; border: 1px solid #e9ecef; background: #f8f9fa;
    }
    .prep-unreadable {
        margin: 10px 0 0; font-size: .78rem; color: #8a5518;
    }
    @media (max-width: 575.98px) {
        .prep-total { float: none; display: block; margin-top: 3px; }
        .prep-shot  { width: 88px; }
    }
    .fiche-step-num {
        width: 26px;
        height: 26px;
        min-width: 26px;
        background: #495057;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 700;
    }

    /* --- TYPY PRZYGOTOWANIA (czas) --- */
    .prep-types { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .prep-type-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        color: #1b5e20;
        font-weight: 600;
    }

    /* --- KOMPETENCJE --- */
    .competence-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .competence-item:last-child { border-bottom: none; }
    .competence-icon {
        width: 32px;
        height: 32px;
        min-width: 32px;
        background: #6c757d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .competence-icon i { color: #fff; font-size: 0.85rem; }
    .competence-name { font-size: 0.85rem; font-weight: 700; color: #212529; }
    .competence-desc { font-size: 0.77rem; color: #6c757d; margin-top: 2px; }

    /* --- PLANOGRAMME (dół full-width) --- */
    .fiche-plano {
        border-top: 1px solid #dee2e6;
        padding: 20px 24px;
    }
    .fiche-plano-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }
    .fiche-plano-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
    }
    .plano-photos { display: flex; gap: 16px; }
    .plano-photo {
        flex: 1;
        height: 160px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        font-size: 0.8rem;
        position: relative;
        overflow: hidden;
    }
    .plano-photo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 6px;
    }

    /* --- OPAKOWANIE (w plano) --- */
    .package-materials-table td, .package-materials-table th {
        font-size: 0.8rem;
        padding: 6px 10px;
    }

    @media (max-width: 768px) {
        .fiche-main { flex-direction: column; }
        .fiche-header { flex-direction: column; }
        .fiche-hero { aspect-ratio: 4 / 3; max-height: 38vh; }
        .plano-photos { flex-direction: column; }
    }

    /* ══ TABLETTE ═══════════════════════════════════════════════════════
       C'est l'écran réel de cette fiche : une tablette posée près du four,
       consultée debout, à bout de bras, avec les mains occupées.

       Deux colonnes ne passaient en une seule qu'en dessous de 768 px. Une
       tablette en portrait fait 810 : elle restait donc en deux colonnes,
       chacune trop étroite — les puces d'allergènes se cassaient, tandis
       que la colonne de droite restait à moitié vide. Le seuil monte à
       1024 px : portrait sur une colonne, paysage sur deux.
       ══════════════════════════════════════════════════════════════════ */
    /* Sur tablette, la fiche est lue plus loin de l'œil qu'un téléphone et
       plus loin qu'un écran de bureau. Les tailles d'origine — 0,72 à
       0,88 rem — y sont trop petites : tout le corps de texte remonte d'un
       cran, sans toucher à la mise en page. */
    @media (min-width: 600px) and (max-width: 1366px) {
        .fiche-section-title  { font-size: .82rem; letter-spacing: .06em; }
        .fiche-info-row       { font-size: .95rem; padding: 11px 0; }
        .fiche-info-label     { min-width: 190px; }
        .fiche-step           { font-size: .98rem; padding: 14px 0; line-height: 1.55; }
        .fiche-step-num       { width: 30px; height: 30px; min-width: 30px; font-size: .82rem; }
        .fiche-note-box p     { font-size: .95rem; line-height: 1.6; }
        .fiche-product-desc   { font-size: 1rem; }
        .fiche-badge          { font-size: .85rem; padding: 5px 12px; }
        .allergen-note        { font-size: .88rem; }
        .package-materials-table td,
        .package-materials-table th { font-size: .95rem; padding: 11px 10px; }
        .fiche-sec            { padding: 22px 26px; }
    }

    /* En portrait, l'intitulé et sa valeur se disputaient la largeur : le
       libellé réservait 190 px et la valeur se cassait en deux lignes. Ils
       passent l'un au-dessus de l'autre. */
    @media (max-width: 820px) {
        .fiche-info-row { flex-direction: column; align-items: flex-start; gap: 2px; }
        .fiche-info-label { min-width: 0; }
        .fiche-info-value { font-size: 1.02rem; }
    }

    /* Les vignettes de photo servent de déclencheur à la visionneuse :
       elles doivent se viser au doigt, pas au curseur. */
    @media (pointer: coarse) {
        .fiche-hero { min-height: 180px; }
        .plano-photo { min-height: 120px; }
    }

    /* --- LIGHTBOX --- */
    .fiche-lightbox {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0,0,0,0.88);
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
    }
    .fiche-lightbox.active { display: flex; }
    .fiche-lightbox img {
        max-width: 92vw;
        max-height: 92vh;
        object-fit: contain;
        border-radius: 6px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.6);
        cursor: default;
    }
    .fiche-lightbox-close {
        position: fixed;
        top: 18px;
        right: 24px;
        color: #fff;
        font-size: 2rem;
        cursor: pointer;
        opacity: 0.8;
        line-height: 1;
        z-index: 10000;
    }
    .fiche-lightbox-close:hover { opacity: 1; }
    .fiche-zoomable {
        cursor: zoom-in;
    }
</style>
{% endblock %}

{% block page_heading %}
    {# Le titre « Fiche technique » et le nom du produit doublaient ce qui est
       déjà sous la photo : deux lignes avant l'image, pour ne rien apprendre.
       Il ne reste que le retour, en haut à gauche — là où on le cherche, et
       dans le coin qu'atteint le pouce quand la tablette est tenue à deux
       mains. En pied de page, il fallait parcourir toute la fiche. #}
    <a href="{{ ROOT }}/knowledge/products" class="fiche-back">
        <i class="bi bi-arrow-left"></i>
        <span>{{ translations.back_to_products|default("Retour à la liste des produits") }}</span>
    </a>
{% endblock %}

{% block content %}

    {% include "page_components/alerts.twig" %}

    {% set obj = product.getObject() %}
    {% set photos = product.getPhotos() %}
    {% set recipe = product.getRecipe() %}
    {% set preparation = product.getPreparation() %}
    {% set package = product.getPackage() %}
    {% set allAllergens = product.getAllAllergens() %}

    {# ====================================================== #}
    {# KARTA TECHNICZNA                                       #}
    {# ====================================================== #}
    <div class="fiche-wrap mb-4">

        {# ---- PHOTO, EN TÊTE ET SUR TOUTE LA LARGEUR ----
           Elle vivait dans un coin de l'en-tête, en 180x130. Or en cuisine
           on compare ce qu'on a produit à ce qu'on doit obtenir : sur cette
           fiche, c'est l'image qui porte l'information, pas le texte. Elle
           passe donc devant, en pleine largeur, bornée en hauteur pour que
           la lecture puisse commencer sans faire défiler. #}
        <div class="fiche-hero">
            {% if photos and photos.hasMainPhoto() %}
                <img src="{{ photos.getMainPhotoUrl() }}"
                     alt="{{ product.getName() }}"
                     class="fiche-zoomable"
                     onclick="ficheLightboxOpen(this)"
                     onerror="ficheImgError(this)">
                <span class="fiche-hero-zoom" aria-hidden="true"><i class="bi bi-arrows-fullscreen"></i></span>
            {% else %}
                <div class="fiche-hero-empty">
                    <i class="bi bi-box-seam"></i>
                    <span>{{ translations.no_photo|default("Pas de photo") }}</span>
                </div>
            {% endif %}
        </div>

        {# ---- HEADER ---- #}
        <div class="fiche-header">
            <div class="fiche-header-left">
                {% if obj %}
                    <div class="fiche-category-label">
                        {{ obj.getCategoryName() ?: translations.no_category|default('Brak kategorii') }}
                    </div>
                {% endif %}
                <h1 class="fiche-product-name">{{ product.getName() }}</h1>

                {# Opis – pozycjonowanie lub przechowywanie jako podtytuł #}
                {% if obj and obj.getStorageDescription() %}
                    <p class="fiche-product-desc">
                        <i class="bi bi-thermometer-half me-1"></i>{{ obj.getStorageDescription() }}
                        {% if obj.getPositioningDescription() %}
                            &nbsp;·&nbsp;{{ obj.getPositioningDescription() }}
                        {% endif %}
                    </p>
                {% elseif obj and obj.getPositioningName() %}
                    <p class="fiche-product-desc">{{ obj.getPositioningName() }}</p>
                {% endif %}

                {# Odznaki #}
                <div class="fiche-badges">
                    {% if obj %}
                        {% if obj.getShelfLifeMinutes() %}
                            {% set h = (obj.getShelfLifeMinutes() / 60)|round(0, 'floor') %}
                            {% set m = obj.getShelfLifeMinutes() % 60 %}
                            <span class="fiche-badge fiche-badge-dlc">
                                <i class="bi bi-clock me-1"></i>DLC
                                {% if h > 0 %}{{ h }}{{ translations.hours|default('h') }}{% endif %}{% if m > 0 %} {{ m }}min{% endif %}
                                {% if obj.getShelfLifeCategory() %} · {{ obj.getShelfLifeCategory() }}{% endif %}
                            </span>
                        {% endif %}
                        {% if obj.getSuggestedSalePrice() %}
                            <span class="fiche-badge fiche-badge-price">
                                <i class="bi bi-tag me-1"></i>{{ obj.getSuggestedSalePrice() }} €
                            </span>
                        {% endif %}
                        {% if obj.getIsVegetarian() %}
                            <span class="fiche-badge fiche-badge-veg">
                                <i class="bi bi-leaf me-1"></i>{{ translations.vegetarian|default("Végétarien") }}
                            </span>
                        {% endif %}
                        {% if obj.getIsPreparedBeforeSales() %}
                            <span class="fiche-badge fiche-badge-prep">
                                <i class="bi bi-clock-history me-1"></i>{{ translations.prepared_before|default("Préparé à l'avance") }}
                            </span>
                        {% endif %}
                        {% if obj.getNutriscore() %}
                            <span class="fiche-badge fiche-badge-nutri">Nutri-Score {{ obj.getNutriscore()|upper }}</span>
                        {% endif %}
                        {% if obj.getLabelSize() %}
                            <span class="fiche-badge fiche-badge-label">
                                <i class="bi bi-upc me-1"></i>{{ obj.getLabelSize() }}
                            </span>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

        </div>

        {# ---- MAIN 2 KOLUMNY ---- #}
        <div class="fiche-main">
            <div class="fiche-sec">

                {# SKŁAD (składniki jako chipy) #}
                <h4 class="fiche-section-title">
                    <i class="bi bi-journal-text me-1"></i>{{ translations.composition|default("Composition") }}
                </h4>
                {% if recipe and recipe.hasElements() %}
                    <div class="ingredient-chips">
                        {% for element in recipe.getElements() %}
                            {% if element.getType() == 'ingredient' %}
                                <span class="ingredient-chip {% if element.hasAllergens() and element.getAllergens()|length > 0 %}has-allergen{% endif %}">
                                    {{ element.getName() }}
                                </span>
                            {% elseif element.getType() == 'sub-recipe' %}
                                <span class="ingredient-chip subrecipe">
                                    <i class="bi bi-layers" style="font-size:0.7rem"></i> {{ element.getName() }}
                                </span>
                                {# Składniki podreceptury jako indywidualne chipy #}
                                {% if element.hasElements() %}
                                    {% for sub in element.getElements() %}
                                        {% if sub.getType() == 'ingredient' %}
                                            <span class="ingredient-chip {% if sub.hasAllergens() and sub.getAllergens()|length > 0 %}has-allergen{% endif %}"
                                                  style="opacity:0.8; font-size:0.73rem">
                                                {{ sub.getName() }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted small">—</p>
                {% endif %}

                {# ALERGENY #}
                <h4 class="fiche-section-title">
                    <i class="bi bi-exclamation-triangle me-1"></i>{{ translations.allergens|default('Alergeny') }}
                </h4>
                {% if allAllergens is not empty %}
                    <div class="allergen-chips">
                        {% for allergen in allAllergens %}
                            <span class="allergen-chip">{{ allergen }}</span>
                        {% endfor %}
                    </div>
                    <p class="allergen-note">→ {{ translations.allergens_check|default("Vérifier les ingrédients avant de servir aux personnes allergiques") }}</p>
                {% else %}
                    <p class="text-muted small">{{ translations.no_allergens|default("Aucun allergène identifié") }}</p>
                {% endif %}

                {# PRZECHOWYWANIE #}
                {% if obj %}
                <h4 class="fiche-section-title">
                    <i class="bi bi-thermometer-half me-1"></i>{{ translations.storage_conditions|default('Warunki przechowywania i serwowania') }}
                </h4>
                <div class="fiche-note-box">
                    <p>
                        {% if obj.getStorageName() %}
                            <strong>{{ obj.getStorageName() }}</strong>
                            {% if obj.getStorageDescription() %} — {{ obj.getStorageDescription() }}{% endif %}
                        {% endif %}
                        {% if obj.getStorageTemperature() %}
                            <br>🌡️ {{ translations.storage_temperature|default('Temperatura') }}: <strong>{{ obj.getStorageTemperature() }}°C</strong>
                        {% endif %}
                        {% if obj.getReheatingTimeMinutes() and obj.getReheatingTimeMinutes() > 0 %}
                            <br>🔥 {{ translations.reheating|default('Podgrzewanie') }}: <strong>{{ obj.getReheatingTimeMinutes() }} min</strong>
                            {% if obj.getReheatingTemperatureCelsius() and obj.getReheatingTemperatureCelsius() > 0 %}
                                / <strong>{{ obj.getReheatingTemperatureCelsius() }}°C</strong>
                            {% endif %}
                        {% endif %}
                        {% if obj.getPositioningName() %}
                            <br>📍 {{ translations.positioning|default('Pozycjonowanie') }}: <strong>{{ obj.getPositioningName() }}</strong>
                            {% if obj.getPositioningDescription() %} — {{ obj.getPositioningDescription() }}{% endif %}
                        {% endif %}
                    </p>
                </div>

                {# INFORMACJE DODATKOWE #}
                <h4 class="fiche-section-title mt-3">
                    <i class="bi bi-info-circle me-1"></i>{{ translations.product_details|default("Détails du produit") }}
                </h4>
                {% if obj.getSingleWeight() %}
                    <div class="fiche-info-row">
                        <span class="fiche-info-label">{{ translations.single_weight|default('Waga jednostkowa') }}</span>
                        <span class="fiche-info-value">{{ obj.getSingleWeight() }} g</span>
                    </div>
                {% endif %}
                {% if recipe and recipe.getYieldQuantity() %}
                    <div class="fiche-info-row">
                        <span class="fiche-info-label">{{ translations.yield|default("Rendement") }}</span>
                        <span class="fiche-info-value">{{ recipe.getYieldQuantity() }} pcs</span>
                    </div>
                {% endif %}
                {# Étiquetage et TVA ne servent pas à produire : ils descendent
                   dans un repli, ouvrable quand on en a besoin. Sur une tablette
                   de cuisine, un taux de TVA au milieu des conditions de service
                   n'est que du bruit. #}
                {% if obj.getQuantityPerLabel() or obj.getTaxValPerc() %}
                    <details class="fiche-admin">
                        <summary>{{ translations.admin_data|default('Données de gestion') }}</summary>
                        {% if obj.getQuantityPerLabel() %}
                            <div class="fiche-info-row">
                                <span class="fiche-info-label">{{ translations.quantity_per_label|default("Quantité par étiquette") }}</span>
                                <span class="fiche-info-value">{{ obj.getQuantityPerLabel() }}</span>
                            </div>
                        {% endif %}
                        {% if obj.getTaxValPerc() %}
                            <div class="fiche-info-row">
                                <span class="fiche-info-label">{{ translations.tax|default('Stawka VAT') }}</span>
                                <span class="fiche-info-value">{{ obj.getTaxValPerc() }}%</span>
                            </div>
                        {% endif %}
                    </details>
                {% endif %}
                {% endif %}{# /if obj #}

            </div>

            <div class="fiche-sec">

                {# PRZYGOTOWANIE – typy #}
                {% if preparation and preparation.hasTypes() %}
                    <div class="prep-types">
                        {% for type in preparation.getTypes() %}
                            <span class="prep-type-chip">
                                <i class="bi bi-stopwatch"></i>
                                {{ type.getName() }}
                                {% if type.getDurationMinutes() %}
                                    <strong>{{ type.getDurationMinutes() }} min</strong>
                                {% endif %}
                            </span>
                        {% endfor %}
                    </div>
                {% endif %}

                {# ── PARCOURS DE PRÉPARATION ──
                   Sa propre route (`GET /products/{id}/preparation-path`), et
                   trois issues qui ne se ressemblent pas :

                     served       — le réseau a défini un parcours : on l'affiche,
                                    avec durées, four et batch.
                     unconfigured — la route répond, ce produit n'a pas de
                                    parcours. Un fait, pas une panne : il se
                                    règle au back-office. On retombe alors sur
                                    la préparation de la fiche technique, qui
                                    vient d'une autre route et est bien réelle.
                     missing      — la route n'a pas répondu. Le bandeau du haut
                                    la nomme déjà ; on ne masque pas pour autant
                                    ce que la fiche technique, elle, a servi. #}
                {% set prep_steps = prep.state is defined and prep.state == 'served' %}

                {% if prep_steps %}
                    <h4 class="fiche-section-title">
                        <i class="bi bi-list-ol me-1"></i>{{ translations.preparation|default('Przygotowanie') }}
                        {% if prep.total %}
                            <span class="prep-total">{{ prep.total }}</span>
                        {% endif %}
                    </h4>

                    {% for step in prep.steps %}
                        <div class="fiche-step">
                            <div class="fiche-step-num">{{ step.n }}</div>
                            <div class="prep-step-body">
                                <div>{{ step.text }}</div>

                                {# Les conditions de l'étape. Elles ne sont pas
                                   décoratives : c'est ce qui dit combien on
                                   enfourne d'un coup, et ce qui peut passer
                                   avec quoi. #}
                                {% set d = step.duration %}
                                {% if d or step.oven or step.batch_group or step.batch_capacity %}
                                    <div class="prep-step-meta">
                                        {% if d %}
                                            <span class="prep-chip"><i class="bi bi-stopwatch"></i>{{ d }}</span>
                                        {% endif %}
                                        {% if step.oven %}
                                            <span class="prep-chip is-oven">
                                                <i class="bi bi-fire"></i>{{ translations.prep_oven|default('Four') }}
                                                {%- if step.per_tray and step.trays %}
                                                    · {{ step.per_tray }} × {{ step.trays }}
                                                    {{- ' ' }}{{ translations.prep_trays|default('plaques') }}
                                                {% endif %}
                                            </span>
                                        {% endif %}
                                        {% if step.batch_group %}
                                            <span class="prep-chip"><i class="bi bi-collection"></i>{{ step.batch_group }}</span>
                                        {% endif %}
                                        {% if step.batch_capacity %}
                                            <span class="prep-chip">
                                                <i class="bi bi-box-seam"></i>
                                                {{- ' ' }}{{ translations.prep_batch_max|default('%s à la fois')|replace({'%s': step.batch_capacity}) }}
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                {% if step.photos is not empty %}
                                    <div class="prep-step-shots">
                                        {# Même règle que ProductPhotoModel::resolveUrl() : une clé
                                           « r2:// » désigne le stockage partagé, une URL entière se
                                           suit telle quelle. #}
                                        {% for photo in step.photos %}
                                            {% set src = photo starts with 'http'
                                                 ? photo
                                                 : shared_files_url ~ '/' ~ (photo starts with 'r2://' ? photo|slice(5) : photo)|trim('/') %}
                                            <img src="{{ src }}" alt="" loading="lazy" class="prep-shot">
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}

                    {# Des étapes servies qu'on n'a pas su lire. Les taire
                       ferait passer un parcours tronqué pour un parcours
                       complet — et c'est sur un parcours qu'on travaille. #}
                    {% if prep.unreadable > 0 %}
                        <p class="prep-unreadable">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            {{ (translations.prep_unreadable|default('%s étape(s) servie(s) sans instruction lisible.'))|replace({'%s': prep.unreadable}) }}
                        </p>
                    {% endif %}

                {# KROKI PRZYGOTOWANIA — la préparation de la fiche technique.
                   Elle reste la source tant que le produit n'a pas de parcours,
                   ou tant que la route du parcours ne répond pas. #}
                {% elseif preparation and preparation.hasSteps() %}
                    <h4 class="fiche-section-title">
                        <i class="bi bi-list-ol me-1"></i>{{ translations.preparation|default('Przygotowanie') }}
                    </h4>
                    {% for step in preparation.getSteps() %}
                        <div class="fiche-step">
                            <div class="fiche-step-num">{{ step.getStepNumber() }}</div>
                            <div>{{ step.getStepDescription() }}</div>
                        </div>
                    {% endfor %}
                {% endif %}
                {# Une section « Préparation » titrée pour n'afficher qu'un tiret
                   occupait une place et faisait chercher une information qui
                   n'existe pas. Sans étapes, elle disparaît. #}

                {# RECEPTURA SZCZEGÓŁOWA (drzewo składników z ilościami) #}
                {% if recipe and recipe.hasElements() %}
                    <h4 class="fiche-section-title">
                        <i class="bi bi-diagram-3 me-1"></i>{{ translations.recipe_quantities|default("Quantités des ingrédients") }}
                    </h4>
                    {% for element in recipe.getElements() %}
                        {% if element.getType() == 'ingredient' %}
                            <div class="fiche-info-row">
                                <span class="fiche-info-label">{{ element.getName() }}</span>
                                <span class="fiche-info-value">{{ element.getRecipeQuantity() }} {{ element.getUnitName() }}</span>
                            </div>
                        {% elseif element.getType() == 'sub-recipe' %}
                            <div class="fiche-info-row" style="background:#fff8e1; border-radius:4px; padding:6px 8px;">
                                <span class="fiche-info-label fw-bold">
                                    <i class="bi bi-layers me-1 text-warning"></i>{{ element.getName() }}
                                </span>
                                <span class="fiche-info-value">{{ element.getRecipeQuantity() }} {{ element.getUnitName() }}</span>
                            </div>
                            {% if element.hasElements() %}
                                {% for sub in element.getElements() %}
                                    <div class="fiche-info-row" style="padding-left:20px; font-size:0.8rem;">
                                        <span class="fiche-info-label text-muted">↳ {{ sub.getName() }}</span>
                                        <span class="fiche-info-value text-muted">{{ sub.getRecipeQuantity() }} {{ sub.getUnitName() }}</span>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {# WYMAGANE KOMPETENCJE #}
                {% if product.hasCompetences() %}
                    <h4 class="fiche-section-title">
                        <i class="bi bi-mortarboard me-1"></i>{{ translations.required_competences|default('Wymagane kompetencje') }}
                    </h4>
                    {% for competence in product.getCompetences() %}
                        <div class="competence-item">
                            <div class="competence-icon">
                                <i class="bi bi-award"></i>
                            </div>
                            <div>
                                <div class="competence-name">{{ competence.getName() }}</div>
                                {% if competence.getDescription() %}
                                    <div class="competence-desc">{{ competence.getDescription() }}</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}

            </div>

        </div>{# /fiche-main #}

        {# ---- PLANOGRAMME – pełna szerokość (zdjęcia + opakowanie) ---- #}
        <div class="fiche-plano">
            <div class="fiche-plano-header">
                <span class="fiche-plano-title">
                    <i class="bi bi-images me-1"></i>{{ translations.planogram|default('Prezentacja & Opakowanie') }}
                </span>
                {% if package %}
                    <span class="text-muted" style="font-size:0.8rem">
                        <i class="bi bi-box me-1"></i>{{ package.getName() }}
                        {% if package.getDescription() %} — {{ package.getDescription() }}{% endif %}
                    </span>
                {% endif %}
            </div>

            <div class="row g-3">

                                {# Planogram – modul Prezentacja i Ekspozycja do dobudowania w przyszlosci #}
                <div class="col-12 col-md-6">
                    <div class="plano-photo" style="height:120px; flex-direction:column; gap:6px;">
                        <i class="bi bi-easel" style="font-size:1.8rem; color:#ced4da"></i>
                        <span style="font-size:0.78rem; color:#adb5bd">{{ translations.photo_presentation|default('Prezentacja') }}</span>
                        <span style="font-size:0.68rem; color:#ced4da; font-style:italic">{{ translations.coming_soon|default("Bientôt disponible") }}</span>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="plano-photo" style="height:120px; flex-direction:column; gap:6px;">
                        <i class="bi bi-layout-wtf" style="font-size:1.8rem; color:#ced4da"></i>
                        <span style="font-size:0.78rem; color:#adb5bd">{{ translations.photo_display|default('Ekspozycja') }}</span>
                        <span style="font-size:0.68rem; color:#ced4da; font-style:italic">{{ translations.coming_soon|default("Bientôt disponible") }}</span>
                    </div>
                </div>

                {# Opakowanie – tabela materiałów #}
                {% if package and package.hasMaterials() %}
                    <div class="col-12">
                        <h6 class="fiche-section-title mb-2" style="margin-top:0">
                            <i class="bi bi-box me-1"></i>{{ translations.packaging_materials|default("Matériaux d'emballage") }}
                        </h6>
                        <table class="table table-sm table-hover package-materials-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>{{ translations.material_name|default("Matériau") }}</th>
                                    <th class="text-center">{{ translations.quantity|default("Qté") }}</th>
                                    <th class="text-center">{{ translations.unit|default('Jedn.') }}</th>
                                    <th class="text-end">{{ translations.price_gross|default('Cena brutto') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for material in package.getMaterials() %}
                                    <tr>
                                        <td>{{ material.getName() }}</td>
                                        <td class="text-center">{{ material.getQuantity() }}</td>
                                        <td class="text-center">{{ material.getUnitName() }}</td>
                                        <td class="text-end">{{ material.getBaseUnitPriceGross()|number_format(3, ',', ' ') }} €</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {# Fallback – brak zdjęć i opakowania #}
                {% if not package or not package.hasMaterials() %}
                    <div class="col-12 text-center text-muted py-3">
                        <i class="bi bi-image" style="font-size:2rem"></i>
                        <p class="mt-2 small">{{ translations.no_media|default("Pas de photos ni de matériaux d'emballage disponibles") }}</p>
                    </div>
                {% endif %}

            </div>
        </div>

    </div>{# /fiche-wrap #}


    {# ---- GALERIA ZDJEC ---- #}
    {% set hasPhoto1gallery = photos and photos.hasPhoto1() %}
    {% set hasPhoto2gallery = photos and photos.hasPhoto2() %}
    {% set hasPhoto3gallery = photos and photos.hasPhoto3() %}
    {% set hasMainGallery = photos and photos.hasMainPhoto() %}
    {% if hasPhoto1gallery or hasPhoto2gallery or hasPhoto3gallery or hasMainGallery %}
    <div class="fiche-wrap mb-4">
        <div class="fiche-plano">
            <div class="fiche-plano-header">
                <span class="fiche-plano-title">
                    <i class="bi bi-images me-1"></i>{{ translations.photos|default('Zdjecia') }}
                </span>
            </div>
            <div class="plano-photos">
                {% if hasPhoto1gallery %}
                    <div class="plano-photo">
                        <img src="{{ photos.getPhoto1Url() }}"
                             alt="{{ product.getName() }} - photo 1"
                             class="fiche-zoomable"
                             onclick="ficheLightboxOpen(this)"
                             onerror="ficheImgErrorSmall(this)">
                        <span class="fiche-photo-label">{{ translations.photo_1|default('Zdjecie 1') }}</span>
                    </div>
                {% endif %}
                {% if hasPhoto2gallery %}
                    <div class="plano-photo">
                        <img src="{{ photos.getPhoto2Url() }}"
                             alt="{{ product.getName() }} - photo 2"
                             class="fiche-zoomable"
                             onclick="ficheLightboxOpen(this)"
                             onerror="ficheImgErrorSmall(this)">
                        <span class="fiche-photo-label">{{ translations.photo_2|default('Zdjecie 2') }}</span>
                    </div>
                {% endif %}
                {% if hasPhoto3gallery %}
                    <div class="plano-photo">
                        <img src="{{ photos.getPhoto3Url() }}"
                             alt="{{ product.getName() }} - photo 3"
                             class="fiche-zoomable"
                             onclick="ficheLightboxOpen(this)"
                             onerror="ficheImgErrorSmall(this)">
                        <span class="fiche-photo-label">{{ translations.photo_3|default('Zdjecie 3') }}</span>
                    </div>
                {% endif %}
                {% if hasMainGallery %}
                    <div class="plano-photo">
                        <img src="{{ photos.getMainPhotoUrl() }}"
                             alt="{{ product.getName() }} - main"
                             class="fiche-zoomable"
                             onclick="ficheLightboxOpen(this)"
                             onerror="ficheImgErrorSmall(this)">
                        <span class="fiche-photo-label">{{ translations.main_photo|default('Glowne') }}</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# Lightbox #}
    <div class="fiche-lightbox" id="ficheLightbox" onclick="ficheLightboxClose()">
        <span class="fiche-lightbox-close" onclick="ficheLightboxClose()">&times;</span>
        <img id="ficheLightboxImg" src="" alt="" onclick="event.stopPropagation()">
    </div>


{% endblock %}

{% block scripts %}
<script>
function ficheImgError(img) {
    var p = img.parentElement;
    img.remove();
    p.innerHTML = '<i class="bi bi-box-seam" style="font-size:2.5rem;color:#ced4da"></i>'
                + '<span style="margin-top:8px;font-size:0.78rem">{{ translations.no_photo|default("Brak zdj\u0119cia") }}</span>';
}
function ficheImgErrorSmall(img) {
    var p = img.parentElement;
    img.remove();
    p.innerHTML = '<i class="bi bi-image" style="font-size:2rem;color:#ced4da"></i>';
}
function ficheLightboxOpen(img) {
    var lb = document.getElementById('ficheLightbox');
    var lbImg = document.getElementById('ficheLightboxImg');
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lb.classList.add('active');
    document.body.style.overflow = 'hidden';
}
function ficheLightboxClose() {
    document.getElementById('ficheLightbox').classList.remove('active');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') ficheLightboxClose();
});
</script>
{% endblock %}
