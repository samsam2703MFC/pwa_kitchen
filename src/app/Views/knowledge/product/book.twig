{#
  LE PAS À PAS — la fiche technique remise en pages, une étape par écran, à la manière
  de la cuisson guidée d'un Thermomix. Pensé pour la tablette posée au plan de travail :
  textes en gros, gros boutons, glisser pour tourner la page, minuteurs qui sonnent,
  écran qui ne se met pas en veille.

  Pages : 0 « Avant de commencer » · 1 « Mise en place » · une page par étape · « C'est prêt ».
  Ouverture directe : /kitchen/knowledge/products/{id}#pas-a-pas (ou #pas-a-pas/3 pour la page 3).

  Données : `book`, construit par ProductionBookBuilder à partir de la fiche.
#}
{% set t = translations %}
{% set obj = product.getObject() %}
{% set photos = product.getPhotos() %}
{% set package = product.getPackage() %}
{% set allAllergens = product.getAllAllergens() %}
{% set ingByKey = {} %}
{% for ing in book.ingredients %}{% set ingByKey = ingByKey|merge({(ing.key): ing}) %}{% endfor %}
{% set pageCount = 3 + book.steps|length %}

<style>
    .pb-book {
        position: fixed; inset: 0; z-index: 1090;
        display: none; flex-direction: column;
        background: #fbfaf7; color: #1f2328;
        font-size: 18px;
        -webkit-user-select: none; user-select: none;
    }
    .pb-book.open { display: flex; }
    body.pb-locked { overflow: hidden; }
    .pb-book button:focus, .pb-dock button:focus { outline: none; box-shadow: none; }
    .pb-book button:focus-visible, .pb-dock button:focus-visible { outline: 3px solid #8fc9a9; outline-offset: 2px; }

    /* --- barre du haut --- */
    .pb-top {
        display: flex; align-items: center; gap: 16px;
        padding: 12px 20px; background: #fff; border-bottom: 1px solid #ebe7de;
    }
    .pb-top-title { flex: 1; min-width: 0; }
    .pb-top-name { font-weight: 800; font-size: 1.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pb-top-where { font-size: .9rem; color: #6b6f76; }
    .pb-scale-badge {
        display: none; background: #1f7a4d; color: #fff; font-weight: 800;
        padding: 6px 14px; border-radius: 999px; font-size: 1rem;
    }
    .pb-scale-badge.on { display: inline-block; }
    .pb-close {
        border: 0; background: #f1efe9; color: #1f2328; border-radius: 12px;
        min-width: 56px; height: 56px; padding: 0 18px; font-size: 1rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .pb-close i { font-size: 2rem; line-height: 1; }

    /* --- progression --- */
    .pb-progress { display: flex; gap: 4px; padding: 10px 20px; background: #fff; border-bottom: 1px solid #ebe7de; }
    .pb-progress button {
        flex: 1; border: 0; padding: 8px 0; background: transparent; cursor: pointer;
    }
    .pb-progress button span { display: block; height: 8px; border-radius: 4px; background: #e5e1d8; }
    .pb-progress button.done span { background: #8fc9a9; }
    .pb-progress button.current span { background: #1f7a4d; }

    /* --- pages --- */
    .pb-pages { flex: 1; overflow: hidden; position: relative; }
    .pb-page {
        display: none; position: absolute; inset: 0; overflow-y: auto;
        padding: 28px 32px 24px; -webkit-overflow-scrolling: touch;
    }
    .pb-page.active { display: block; animation: pbIn .22s ease-out; }
    .pb-page.active.back { animation-name: pbInBack; }
    @keyframes pbIn { from { opacity: 0; transform: translateX(28px); } to { opacity: 1; transform: none; } }
    @keyframes pbInBack { from { opacity: 0; transform: translateX(-28px); } to { opacity: 1; transform: none; } }

    .pb-eyebrow { font-size: .85rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #1f7a4d; margin-bottom: 6px; }
    .pb-h1 { font-size: 2.1rem; font-weight: 800; line-height: 1.15; margin: 0 0 10px; color: #1f2328; }
    /* Les icônes des boutons au centre, pas sur la ligne de base du texte. */
    .pb-btn i, .pb-timer-btn i, .pb-close i, .pb-chip i, .pb-launch i, .pb-dock-pill i, .pb-mep-check i {
        display: inline-flex; align-items: center; justify-content: center; line-height: 1;
    }
    .pb-btn i::before, .pb-timer-btn i::before, .pb-close i::before, .pb-chip i::before,
    .pb-launch i::before, .pb-dock-pill i::before, .pb-mep-check i::before { display: block; vertical-align: 0; }
    .pb-lead { font-size: 1.15rem; color: #555a61; margin: 0 0 20px; }

    /* --- couverture --- */
    .pb-cover { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px; align-items: start; }
    .pb-cover-photo {
        aspect-ratio: 4 / 3; border-radius: 18px; background: #f1efe9; overflow: hidden;
        display: flex; align-items: center; justify-content: center; color: #b9b3a6; font-size: 4rem;
    }
    .pb-cover-photo img { width: 100%; height: 100%; object-fit: cover; }
    .pb-facts { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 20px; }
    .pb-fact {
        background: #fff; border: 1px solid #ebe7de; border-radius: 14px; padding: 10px 16px;
        font-size: 1rem; display: flex; align-items: center; gap: 8px;
    }
    .pb-fact strong { font-size: 1.15rem; }
    .pb-fact i { color: #1f7a4d; font-size: 1.2rem; }
    .pb-scale {
        background: #fff; border: 2px solid #1f7a4d; border-radius: 18px; padding: 16px 20px; margin-bottom: 18px;
    }
    .pb-scale-label { font-weight: 800; font-size: 1.1rem; margin-bottom: 10px; }
    .pb-scale-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .pb-scale-btn {
        width: 64px; height: 64px; border-radius: 16px; border: 0; background: #1f7a4d; color: #fff;
        font-size: 2rem; font-weight: 800; line-height: 1;
    }
    .pb-scale-btn:disabled { background: #c9d9cf; }
    .pb-scale-value { font-size: 2.2rem; font-weight: 800; min-width: 90px; text-align: center; }
    .pb-scale-result { font-size: 1.15rem; color: #555a61; }
    .pb-scale-result strong { color: #1f2328; font-size: 1.3rem; }
    .pb-warn {
        background: #fdecec; border: 2px solid #f1aeb5; color: #842029; border-radius: 16px;
        padding: 14px 18px; margin-bottom: 14px; font-size: 1.05rem;
    }
    .pb-warn-title { font-weight: 800; margin-bottom: 6px; }
    .pb-tag { display: inline-block; background: #fff; border: 1px solid #f1aeb5; border-radius: 8px; padding: 2px 10px; margin: 2px 4px 2px 0; font-weight: 700; }
    .pb-note { background: #fff8e1; border: 1px solid #ffe08a; border-radius: 14px; padding: 12px 16px; font-size: 1rem; color: #664d03; margin-bottom: 14px; }
    .pb-competences { font-size: .98rem; color: #555a61; }

    /* --- mise en place --- */
    .pb-mep-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
    .pb-mep-count {
        background: #fff; border: 2px solid #ebe7de; border-radius: 14px; padding: 10px 18px;
        font-size: 1.2rem; font-weight: 800; white-space: nowrap;
    }
    .pb-mep-count.all { border-color: #1f7a4d; background: #e7f4ec; color: #1f7a4d; }
    .pb-mep-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
    .pb-mep-item {
        display: flex; align-items: center; gap: 16px; text-align: left;
        background: #fff; border: 2px solid #ebe7de; border-radius: 16px; padding: 14px 16px;
        min-height: 84px; color: inherit; width: 100%;
    }
    .pb-mep-check {
        flex: 0 0 44px; height: 44px; border-radius: 12px; border: 3px solid #c9c3b6;
        display: flex; align-items: center; justify-content: center; font-size: 1.6rem; color: transparent;
    }
    .pb-mep-item[aria-pressed="true"] { border-color: #1f7a4d; background: #e7f4ec; }
    .pb-mep-item[aria-pressed="true"] .pb-mep-check { background: #1f7a4d; border-color: #1f7a4d; color: #fff; }
    .pb-mep-item[aria-pressed="true"] .pb-mep-name { text-decoration: line-through; text-decoration-color: #8fc9a9; }
    .pb-mep-body { flex: 1; min-width: 0; }
    .pb-mep-name { font-size: 1.15rem; font-weight: 700; line-height: 1.25; }
    .pb-mep-sub { font-size: .9rem; color: #6b6f76; margin-top: 2px; }
    .pb-mep-sub i { color: #b8860b; }
    .pb-mep-qty { font-size: 1.5rem; font-weight: 800; white-space: nowrap; text-align: right; }
    .pb-mep-qty small { font-size: 1rem; font-weight: 700; color: #6b6f76; margin-left: 2px; }
    .pb-allergen-dot { display: inline-block; font-size: .75rem; font-weight: 800; color: #842029; background: #fdecec; border-radius: 6px; padding: 1px 7px; margin-top: 4px; }

    /* --- étape --- */
    .pb-step { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 32px; align-items: start; }
    .pb-step-num {
        width: 76px; height: 76px; border-radius: 50%; background: #1f7a4d; color: #fff;
        display: flex; align-items: center; justify-content: center; font-size: 2.3rem; font-weight: 800;
        margin-bottom: 14px;
    }
    .pb-step-text { font-size: clamp(1.45rem, 2.5vw, 2.15rem); line-height: 1.4; font-weight: 600; }
    .pb-hl { display: inline-block; font-weight: 800; border-radius: 10px; padding: 0 10px; margin: 2px 0; line-height: 1.45; white-space: nowrap; }
    .pb-hl-duration { background: #fff1c2; color: #6b4e00; }
    .pb-hl-temp { background: #fde2e0; color: #a1261f; }
    .pb-hl-speed { background: #e1eaff; color: #1d47b8; }
    .pb-hl-tray { background: #e4e8ec; color: #39424a; }

    /* --- mise sur plaque --- */
    .pb-tray { max-width: 620px; }
    .pb-tray-svg { display: block; width: 100%; height: auto; }
    .pb-tray-caption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-top: 10px; font-size: 1.15rem; }
    .pb-tray-caption strong { font-size: 1.5rem; }
    .pb-tray-need { background: #1f2328; color: #fff; border-radius: 10px; padding: 4px 12px; font-weight: 800; }
    .pb-side-title { font-size: .85rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #6b6f76; margin: 0 0 10px; }
    .pb-side-block + .pb-side-block { margin-top: 22px; }
    .pb-chips { display: flex; flex-wrap: wrap; gap: 10px; }
    .pb-chip { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 14px; font-size: 1.25rem; font-weight: 800; }
    .pb-chip.temp { background: #fde2e0; color: #a1261f; }
    .pb-chip.speed { background: #e1eaff; color: #1d47b8; }
    .pb-ing-card {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        background: #fff; border: 2px solid #ebe7de; border-radius: 14px; padding: 12px 16px; margin-bottom: 10px;
    }
    .pb-ing-card .name { font-size: 1.1rem; font-weight: 700; }
    .pb-ing-card .qty { font-size: 1.45rem; font-weight: 800; white-space: nowrap; }
    .pb-ing-card .qty small { font-size: 1rem; color: #6b6f76; }

    /* --- minuteur --- */
    .pb-timer {
        background: #fff; border: 2px solid #ebe7de; border-radius: 18px; padding: 14px 16px; margin-bottom: 12px;
        display: flex; align-items: center; gap: 14px;
    }
    .pb-timer-clock { font-variant-numeric: tabular-nums; font-size: 2.4rem; font-weight: 800; flex: 1; line-height: 1; }
    .pb-timer-label { display: block; font-size: .9rem; font-weight: 700; color: #6b6f76; margin-top: 4px; }
    .pb-timer-btn {
        border: 0; border-radius: 14px; height: 64px; padding: 0 20px; font-size: 1.15rem; font-weight: 800;
        display: inline-flex; align-items: center; gap: 8px; background: #1f7a4d; color: #fff;
    }
    .pb-timer-btn.ghost { background: #f1efe9; color: #1f2328; width: 64px; padding: 0; justify-content: center; }
    .pb-timer-btn i { font-size: 1.5rem; }
    .pb-timer.running { border-color: #1f7a4d; }
    .pb-timer.running .pb-timer-clock { color: #1f7a4d; }
    .pb-timer.ringing { border-color: #dc3545; background: #fdecec; animation: pbRing 1s infinite; }
    .pb-timer.ringing .pb-timer-clock { color: #dc3545; }
    @keyframes pbRing { 50% { box-shadow: 0 0 0 8px rgba(220, 53, 69, .18); } }

    /* --- fin --- */
    .pb-done-icon {
        width: 96px; height: 96px; border-radius: 50%; background: #e7f4ec; color: #1f7a4d;
        display: flex; align-items: center; justify-content: center; font-size: 3.2rem; margin-bottom: 14px;
    }
    .pb-done-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin: 10px 0 24px; }
    .pb-done-card { background: #fff; border: 1px solid #ebe7de; border-radius: 16px; padding: 14px 18px; }
    .pb-done-card .k { font-size: .85rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #6b6f76; }
    .pb-done-card .v { font-size: 1.3rem; font-weight: 800; margin-top: 4px; }
    .pb-done-card .d { font-size: .98rem; color: #555a61; margin-top: 2px; }
    .pb-done-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    /* --- barre du bas --- */
    .pb-bottom { display: flex; gap: 14px; padding: 14px 20px; background: #fff; border-top: 1px solid #ebe7de; }
    .pb-btn {
        border: 0; border-radius: 16px; min-height: 76px; padding: 0 24px; font-size: 1.35rem; font-weight: 800;
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    }
    .pb-btn i { font-size: 1.7rem; }
    .pb-btn-prev { flex: 0 0 30%; background: #f1efe9; color: #1f2328; }
    .pb-btn-prev:disabled { opacity: .35; }
    .pb-btn-next { flex: 1; background: #1f7a4d; color: #fff; }
    .pb-btn-next.finish { background: #14532d; }
    .pb-btn-light { background: #f1efe9; color: #1f2328; }

    /* --- minuteurs en cours, visibles partout (dans le book comme sur la fiche) --- */
    .pb-dock { position: fixed; left: 20px; bottom: 24px; z-index: 1095; display: flex; flex-direction: column; gap: 8px; }
    .pb-dock:empty, .pb-dock-top:empty { display: none; }
    .pb-dock-top { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .pb-dock-top .pb-dock-pill { padding: 10px 16px; font-size: 1rem; box-shadow: none; }
    .pb-dock-pill {
        border: 0; border-radius: 999px; padding: 12px 20px; font-size: 1.1rem; font-weight: 800;
        background: #1f2328; color: #fff; box-shadow: 0 6px 20px rgba(0,0,0,.25);
        display: inline-flex; align-items: center; gap: 10px; font-variant-numeric: tabular-nums;
    }
    .pb-dock-pill.ringing { background: #dc3545; animation: pbRing 1s infinite; }

    /* --- déclencheurs sur la fiche --- */
    .pb-launch {
        display: inline-flex; align-items: center; gap: 12px; margin-top: 14px;
        background: #1f7a4d; color: #fff; border: 0; border-radius: 14px; padding: 14px 22px;
        font-size: 1.15rem; font-weight: 800; box-shadow: 0 4px 14px rgba(31, 122, 77, .28);
    }
    .pb-launch i { font-size: 1.6rem; }
    .pb-launch small { display: block; font-size: .85rem; font-weight: 600; opacity: .85; }
    .pb-launch:hover { background: #17633e; color: #fff; }
    .pb-launch-inline { border: 0; background: #e7f4ec; color: #1f7a4d; font-weight: 800; border-radius: 10px; padding: 6px 12px; font-size: .85rem; }

    @media (max-width: 900px) {
        .pb-cover, .pb-step { grid-template-columns: minmax(0, 1fr); gap: 18px; }
        .pb-page { padding: 20px 18px; }
        .pb-btn-prev { flex-basis: 34%; }
        .pb-btn { font-size: 1.15rem; }
        .pb-close span { display: none; }
    }
</style>

<div class="pb-book" id="pbBook" role="dialog" aria-modal="true" aria-label="{{ t.book_open|default('Pas à pas') }} — {{ product.getName() }}">

    <div class="pb-top">
        <div class="pb-top-title">
            <div class="pb-top-name">{{ product.getName() }}</div>
            <div class="pb-top-where" id="pbWhere"></div>
        </div>
        <div class="pb-dock-top" id="pbDockTop" aria-live="polite"></div>
        <span class="pb-scale-badge" id="pbScaleBadge"></span>
        <button type="button" class="pb-close" id="pbClose">
            <i class="bi bi-x"></i><span>{{ t.book_close|default('Fermer') }}</span>
        </button>
    </div>

    <div class="pb-progress" id="pbProgress">
        {% for i in 0..(pageCount - 1) %}
            <button type="button" data-go="{{ i }}" aria-label="{{ i + 1 }} / {{ pageCount }}"><span></span></button>
        {% endfor %}
    </div>

    <div class="pb-pages" id="pbPages">

        {# ===== 0 · AVANT DE COMMENCER ===== #}
        <section class="pb-page" data-where="{{ t.book_cover_title|default('Avant de commencer') }}">
            <div class="pb-cover">
                <div class="pb-cover-photo">
                    {% if photos and photos.hasMainPhoto() %}
                        <img src="{{ photos.getMainPhotoUrl() }}" alt="{{ product.getName() }}" onerror="this.remove()">
                    {% else %}
                        <i class="bi bi-egg-fried"></i>
                    {% endif %}
                </div>
                <div>
                    <div class="pb-eyebrow">{{ t.book_cover_title|default('Avant de commencer') }}</div>
                    <h2 class="pb-h1">{{ product.getName() }}</h2>

                    <div class="pb-facts">
                        {% if book.steps is not empty %}
                            <div class="pb-fact"><i class="bi bi-list-ol"></i><strong>{{ book.steps|length }}</strong> {{ t.book_steps|default('étapes') }}</div>
                        {% endif %}
                        {% if book.total_label %}
                            <div class="pb-fact"><i class="bi bi-stopwatch"></i>{{ t.book_total_time|default('Temps total') }} <strong>{{ book.total_label }}</strong></div>
                        {% endif %}
                        {% if book.tray %}
                            <div class="pb-fact"><i class="bi bi-grid-3x3"></i>{{ t.book_tray|default('Mise sur plaque') }} <strong>{{ book.tray.label }}</strong></div>
                        {% endif %}
                        {% for phase in book.phases %}
                            {% if phase.label %}
                                <div class="pb-fact">{{ phase.name }} <strong>{{ phase.label }}</strong></div>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if book.ingredients is not empty %}
                        <div class="pb-scale">
                            <div class="pb-scale-label">{{ t.book_batches|default('Combien de fournées ?') }}</div>
                            <div class="pb-scale-row">
                                <button type="button" class="pb-scale-btn" id="pbScaleMinus" aria-label="−">−</button>
                                <div class="pb-scale-value" id="pbScaleValue">× 1</div>
                                <button type="button" class="pb-scale-btn" id="pbScalePlus" aria-label="+">+</button>
                                {% if book.yield %}
                                    <div class="pb-scale-result">
                                        = <strong id="pbScaleYield" data-qty="{{ book.yield }}">{{ book.yield_label }}</strong>
                                        {{ t.book_pieces|default('pièces') }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {% if allAllergens is not empty %}
                        <div class="pb-warn">
                            <div class="pb-warn-title"><i class="bi bi-exclamation-triangle-fill me-1"></i>{{ t.book_allergens_warning|default('Allergènes dans cette recette') }}</div>
                            {% for a in allAllergens %}<span class="pb-tag">{{ a }}</span>{% endfor %}
                        </div>
                    {% endif %}

                    {% if not book.steps_written %}
                        <div class="pb-note"><i class="bi bi-info-circle me-1"></i>{{ t.book_no_steps|default("Les étapes de cette fiche ne sont pas encore rédigées : faites la mise en place, puis suivez la fiche technique.") }}</div>
                    {% endif %}

                    {% if product.hasCompetences() %}
                        <div class="pb-competences">
                            <i class="bi bi-award me-1"></i>{{ t.required_competences|default('Compétences requises') }} :
                            {% for c in product.getCompetences() %}<strong>{{ c.getName() }}</strong>{% if not loop.last %}, {% endif %}{% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        {# ===== 1 · MISE EN PLACE ===== #}
        <section class="pb-page" data-where="{{ t.book_mise_en_place|default('Mise en place') }}">
            <div class="pb-mep-head">
                <div>
                    <div class="pb-eyebrow">{{ t.book_mise_en_place|default('Mise en place') }}</div>
                    <h2 class="pb-h1">{{ t.book_mise_en_place_title|default('Sortez et pesez tout') }}</h2>
                    <p class="pb-lead" style="margin:0">{{ t.book_mise_en_place_hint|default('Touchez chaque ingrédient quand il est prêt sur le plan de travail.') }}</p>
                </div>
                {% if book.ingredients is not empty %}
                    <div class="pb-mep-count" id="pbMepCount"></div>
                {% endif %}
            </div>

            {% if book.ingredients is not empty %}
                <div class="pb-mep-grid">
                    {% for ing in book.ingredients %}
                        <button type="button" class="pb-mep-item" aria-pressed="false" data-mep="{{ ing.key }}">
                            <span class="pb-mep-check"><i class="bi bi-check2"></i></span>
                            <span class="pb-mep-body">
                                <span class="pb-mep-name d-block">{{ ing.name }}</span>
                                {% if ing.is_subrecipe %}
                                    <span class="pb-mep-sub d-block">
                                        <i class="bi bi-layers"></i> {{ t.book_homemade|default('Préparation maison') }}{% if ing.contains is not empty %} — {{ ing.contains|join(', ') }}{% endif %}
                                    </span>
                                {% endif %}
                                {% if ing.allergens is not empty %}
                                    <span class="pb-allergen-dot">{{ ing.allergens|join(' · ') }}</span>
                                {% endif %}
                            </span>
                            {% if ing.qty is not null %}
                                <span class="pb-mep-qty"><span class="js-qty" data-qty="{{ ing.qty }}">{{ ing.qty_label }}</span><small>{{ ing.unit }}</small></span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>
            {% else %}
                <div class="pb-note">{{ t.no_recipe_elements|default('Aucun élément de recette trouvé.') }}</div>
            {% endif %}
        </section>

        {# ===== 2… · LES ÉTAPES ===== #}
        {% for step in book.steps %}
            <section class="pb-page" data-step="{{ step.number }}"
                     data-where="{{ t.book_step|default('Étape') }} {{ step.number }} {{ t.book_of|default('sur') }} {{ book.steps|length }}">
                <div class="pb-step">
                    <div>
                        <div class="pb-step-num">{{ step.number }}</div>
                        <div class="pb-step-text">
                            {%- for seg in step.segments -%}
                                {%- if seg.t == 'text' -%}{{ seg.v|nl2br }}{%- else -%}<span class="pb-hl pb-hl-{{ seg.t }}">{{ seg.v }}</span>{%- endif -%}
                            {%- endfor -%}
                        </div>
                    </div>

                    <div>
                        {% if step.tray %}
                            <div class="pb-side-block pb-tray">
                                <h3 class="pb-side-title"><i class="bi bi-grid-3x3 me-1"></i>{{ t.book_tray|default('Mise sur plaque') }}</h3>
                                {{ step.tray.svg|raw }}
                                <div class="pb-tray-caption">
                                    <span><strong>{{ step.tray.label }}</strong> = {{ step.tray.per_tray }} {{ t.book_per_tray|default('par plaque') }}</span>
                                    {% if book.yield %}
                                        <span class="pb-tray-need js-trays" data-per-tray="{{ step.tray.per_tray }}"></span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}

                        {% if step.timers is not empty %}
                            <div class="pb-side-block">
                                <h3 class="pb-side-title"><i class="bi bi-stopwatch me-1"></i>{{ t.book_timer|default('Minuteur') }}</h3>
                                {% for timer in step.timers %}
                                    <div class="pb-timer" data-timer="s{{ step.number }}-{{ loop.index0 }}" data-seconds="{{ timer.seconds }}" data-page-step="{{ step.number }}">
                                        <div class="pb-timer-clock">
                                            <span class="js-clock"></span>
                                            <span class="pb-timer-label">{{ timer.label }}</span>
                                        </div>
                                        <button type="button" class="pb-timer-btn ghost js-timer-reset" aria-label="{{ t.book_timer_reset|default('Remettre à zéro') }}" hidden><i class="bi bi-arrow-counterclockwise"></i></button>
                                        <button type="button" class="pb-timer-btn js-timer-toggle"></button>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if step.temperatures is not empty or step.speeds is not empty %}
                            <div class="pb-side-block">
                                <div class="pb-chips">
                                    {% for v in step.temperatures %}<span class="pb-chip temp"><i class="bi bi-thermometer-half"></i>{{ v }}</span>{% endfor %}
                                    {% for v in step.speeds %}<span class="pb-chip speed"><i class="bi bi-speedometer2"></i>{{ v }}</span>{% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {% if step.ingredients is not empty %}
                            <div class="pb-side-block">
                                <h3 class="pb-side-title"><i class="bi bi-basket me-1"></i>{{ t.book_step_ingredients|default('Ingrédients de cette étape') }}</h3>
                                {% for key in step.ingredients %}
                                    {% set ing = ingByKey[key] %}
                                    <div class="pb-ing-card">
                                        <span class="name">{% if ing.is_subrecipe %}<i class="bi bi-layers me-1" style="color:#b8860b"></i>{% endif %}{{ ing.name }}</span>
                                        {% if ing.qty is not null %}
                                            <span class="qty"><span class="js-qty" data-qty="{{ ing.qty }}">{{ ing.qty_label }}</span> <small>{{ ing.unit }}</small></span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </section>
        {% endfor %}

        {# ===== FIN · C'EST PRÊT ===== #}
        <section class="pb-page" data-where="{{ t.book_done_title|default("C'est prêt !") }}">
            <div class="pb-done-icon"><i class="bi bi-check2"></i></div>
            <div class="pb-eyebrow">{{ product.getName() }}</div>
            <h2 class="pb-h1">{{ t.book_done_title|default("C'est prêt !") }}</h2>
            <p class="pb-lead">{{ t.book_done_hint|default('Emballez, étiquetez, rangez — comme indiqué ci-dessous.') }}</p>

            <div class="pb-done-grid">
                {% if obj and (obj.getStorageName() or obj.getStorageTemperature()) %}
                    <div class="pb-done-card">
                        <div class="k"><i class="bi bi-thermometer-half me-1"></i>{{ t.storage|default('Stockage') }}</div>
                        <div class="v">{{ obj.getStorageName() }}{% if obj.getStorageTemperature() %} · {{ obj.getStorageTemperature() }}°C{% endif %}</div>
                        {% if obj.getStorageDescription() %}<div class="d">{{ obj.getStorageDescription() }}</div>{% endif %}
                    </div>
                {% endif %}
                {% if obj and obj.getShelfLifeMinutes() %}
                    {% set h = (obj.getShelfLifeMinutes() / 60)|round(0, 'floor') %}
                    {% set m = obj.getShelfLifeMinutes() % 60 %}
                    <div class="pb-done-card">
                        <div class="k"><i class="bi bi-clock me-1"></i>{{ t.shelf_life|default('Durée de vie') }}</div>
                        <div class="v">{% if h > 0 %}{{ h }} {{ t.hours|default('h') }}{% endif %}{% if m > 0 %} {{ m }} min{% endif %}</div>
                        {% if obj.getShelfLifeCategory() %}<div class="d">{{ obj.getShelfLifeCategory() }}</div>{% endif %}
                    </div>
                {% endif %}
                {% if obj and obj.getReheatingTimeMinutes() and obj.getReheatingTimeMinutes() > 0 %}
                    <div class="pb-done-card">
                        <div class="k"><i class="bi bi-hourglass-split me-1"></i>{{ t.reheating|default('Réchauffage') }}</div>
                        <div class="v">{{ obj.getReheatingTimeMinutes() }} min{% if obj.getReheatingTemperatureCelsius() and obj.getReheatingTemperatureCelsius() > 0 %} · {{ obj.getReheatingTemperatureCelsius() }}°C{% endif %}</div>
                    </div>
                {% endif %}
                {% if package %}
                    <div class="pb-done-card">
                        <div class="k"><i class="bi bi-box me-1"></i>{{ t.packaging|default('Emballage') }}</div>
                        <div class="v">{{ package.getName() }}</div>
                        {% if package.hasMaterials() %}
                            <div class="d">{% for mat in package.getMaterials() %}{{ mat.getQuantity() }} × {{ mat.getName() }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
                        {% elseif package.getDescription() %}
                            <div class="d">{{ package.getDescription() }}</div>
                        {% endif %}
                    </div>
                {% endif %}
                {% if obj and (obj.getLabelSize() or obj.getQuantityPerLabel()) %}
                    <div class="pb-done-card">
                        <div class="k"><i class="bi bi-upc me-1"></i>{{ t.book_label|default('Étiquette') }}</div>
                        <div class="v">{{ obj.getLabelSize() }}</div>
                        {% if obj.getQuantityPerLabel() %}<div class="d">{{ t.quantity_per_label|default('Quantité par étiquette') }} : {{ obj.getQuantityPerLabel() }}</div>{% endif %}
                    </div>
                {% endif %}
                {% if obj and obj.getPositioningName() %}
                    <div class="pb-done-card">
                        <div class="k"><i class="bi bi-geo-alt me-1"></i>{{ t.positioning|default('Positionnement') }}</div>
                        <div class="v">{{ obj.getPositioningName() }}</div>
                        {% if obj.getPositioningDescription() %}<div class="d">{{ obj.getPositioningDescription() }}</div>{% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="pb-done-actions">
                <button type="button" class="pb-btn pb-btn-light" data-go="0"><i class="bi bi-arrow-counterclockwise"></i>{{ t.book_restart|default('Recommencer') }}</button>
                <button type="button" class="pb-btn pb-btn-next" id="pbBackToSheet" style="flex:0 1 auto"><i class="bi bi-file-text"></i>{{ t.book_back_to_sheet|default('Retour à la fiche') }}</button>
            </div>
        </section>
    </div>

    <div class="pb-bottom">
        <button type="button" class="pb-btn pb-btn-prev" id="pbPrev"><i class="bi bi-chevron-left"></i>{{ t.book_prev|default('Précédent') }}</button>
        <button type="button" class="pb-btn pb-btn-next" id="pbNext"><span id="pbNextLabel"></span><i class="bi bi-chevron-right"></i></button>
    </div>
</div>

<div class="pb-dock" id="pbDock" aria-live="polite"></div>

<script type="application/json" id="pbI18n">{{ {
    locale: t.book_locale|default('fr-BE'),
    start: t.book_start|default('Commencer'),
    next: t.book_next|default('Suivant'),
    finish: t.book_finish|default('Terminer'),
    step: t.book_step|default('Étape'),
    ready: t.book_ready|default('prêts'),
    allReady: t.book_all_ready|default('Tout est prêt'),
    timerStart: t.book_timer_start|default('Lancer'),
    timerPause: t.book_timer_pause|default('Pause'),
    timerResume: t.book_timer_resume|default('Reprendre'),
    timerDone: t.book_timer_done|default('Temps écoulé !'),
    timerStop: t.book_timer_stop|default('Arrêter'),
    traysFor: t.book_trays_for|default('Pour'),
    pieces: t.book_pieces|default('pièces'),
    tray: t.book_tray_one|default('plaque'),
    trays: t.book_trays|default('plaques')
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

<script>
(function () {
    'use strict';

    var book = document.getElementById('pbBook');
    if (!book) return;

    var T = JSON.parse(document.getElementById('pbI18n').textContent);
    var HASH = '#pas-a-pas';
    var pages = Array.prototype.slice.call(book.querySelectorAll('.pb-page'));
    var bars = Array.prototype.slice.call(book.querySelectorAll('#pbProgress [data-go]'));
    var where = document.getElementById('pbWhere');
    var prevBtn = document.getElementById('pbPrev');
    var nextBtn = document.getElementById('pbNext');
    var nextLabel = document.getElementById('pbNextLabel');
    var dockFloat = document.getElementById('pbDock');
    var dockTop = document.getElementById('pbDockTop');
    var last = pages.length - 1;
    var current = 0;
    var pushed = false;
    var nf = new Intl.NumberFormat(T.locale, { maximumFractionDigits: 2 });

    /* ---------- pages ---------- */

    function show(i, opts) {
        i = Math.max(0, Math.min(last, i | 0));
        var back = i < current;
        pages.forEach(function (p, k) {
            p.classList.toggle('active', k === i);
            p.classList.toggle('back', k === i && back);
        });
        bars.forEach(function (b, k) {
            b.classList.toggle('done', k < i);
            b.classList.toggle('current', k === i);
        });
        current = i;
        pages[i].scrollTop = 0;
        where.textContent = pages[i].getAttribute('data-where') || '';
        prevBtn.disabled = i === 0;
        nextBtn.style.visibility = i === last ? 'hidden' : '';
        nextBtn.classList.toggle('finish', i === last - 1);
        nextLabel.textContent = i === 0 ? T.start : (i === last - 1 ? T.finish : T.next);
        if (!opts || !opts.silent) {
            history.replaceState(history.state, '', HASH + (i ? '/' + i : ''));
        }
        renderDock();
    }

    function open(i) {
        book.classList.add('open');
        document.body.classList.add('pb-locked');
        if (location.hash.indexOf(HASH) !== 0) {
            history.pushState({ pb: 1 }, '', HASH);
            pushed = true;
        }
        show(i || 0);
        keepAwake(true);
        renderDock();
    }

    function close() {
        book.classList.remove('open');
        document.body.classList.remove('pb-locked');
        if (!anyRunning()) keepAwake(false);
        renderDock();
    }

    function requestClose() {
        if (pushed) {
            pushed = false;
            history.back();          // popstate refermera
        } else {
            history.replaceState(history.state, '', location.pathname + location.search);
            close();
        }
    }

    function pageFromHash() {
        if (location.hash.indexOf(HASH) !== 0) return null;
        var n = parseInt(location.hash.slice(HASH.length + 1), 10);
        return isNaN(n) ? 0 : n;
    }

    window.addEventListener('popstate', function () {
        var p = pageFromHash();
        if (p === null) { pushed = false; close(); }
        else if (!book.classList.contains('open')) open(p);
    });

    document.querySelectorAll('[data-pb-open]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.preventDefault(); open(parseInt(el.getAttribute('data-pb-open'), 10) || 0); });
    });
    document.getElementById('pbClose').addEventListener('click', requestClose);
    document.getElementById('pbBackToSheet').addEventListener('click', requestClose);
    prevBtn.addEventListener('click', function () { show(current - 1); });
    nextBtn.addEventListener('click', function () { show(current + 1); });
    book.querySelectorAll('[data-go]').forEach(function (b) {
        b.addEventListener('click', function () { show(parseInt(b.getAttribute('data-go'), 10)); });
    });

    document.addEventListener('keydown', function (e) {
        if (!book.classList.contains('open')) return;
        if (e.key === 'ArrowRight' || e.key === 'PageDown') show(current + 1);
        else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(current - 1);
        else if (e.key === 'Escape') requestClose();
    });

    // Glisser pour tourner la page — les mains sont prises, un revers suffit.
    var sx = null, sy = null;
    var area = document.getElementById('pbPages');
    area.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) { sx = null; return; }
        sx = e.touches[0].clientX; sy = e.touches[0].clientY;
    }, { passive: true });
    area.addEventListener('touchend', function (e) {
        if (sx === null) return;
        var dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
        sx = null;
        if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    }, { passive: true });

    /* ---------- fournées : toutes les quantités suivent ---------- */

    var scale = 1;
    var scaleValue = document.getElementById('pbScaleValue');
    var scaleBadge = document.getElementById('pbScaleBadge');
    var minus = document.getElementById('pbScaleMinus');
    var plus = document.getElementById('pbScalePlus');

    function applyScale() {
        book.querySelectorAll('.js-qty, #pbScaleYield').forEach(function (el) {
            el.textContent = nf.format(parseFloat(el.getAttribute('data-qty')) * scale);
        });
        // Plaques nécessaires pour la fournée choisie : pièces ÷ pièces par plaque, arrondi au-dessus.
        var yieldEl = document.getElementById('pbScaleYield');
        if (yieldEl) {
            var pieces = parseFloat(yieldEl.getAttribute('data-qty')) * scale;
            book.querySelectorAll('.js-trays').forEach(function (el) {
                var n = Math.ceil(pieces / parseInt(el.getAttribute('data-per-tray'), 10));
                el.textContent = T.traysFor + ' ' + nf.format(pieces) + ' ' + T.pieces + ' : ' + n + ' ' + (n > 1 ? T.trays : T.tray);
            });
        }
        if (scaleValue) scaleValue.textContent = '× ' + nf.format(scale);
        scaleBadge.textContent = '× ' + nf.format(scale);
        scaleBadge.classList.toggle('on', scale !== 1);
        if (minus) minus.disabled = scale <= 0.5;
        if (plus) plus.disabled = scale >= 20;
    }
    if (minus) minus.addEventListener('click', function () { scale = Math.max(0.5, scale - 0.5); applyScale(); });
    if (plus) plus.addEventListener('click', function () { scale = Math.min(20, scale + 0.5); applyScale(); });

    /* ---------- mise en place ---------- */

    var mepItems = Array.prototype.slice.call(book.querySelectorAll('[data-mep]'));
    var mepCount = document.getElementById('pbMepCount');
    function renderMep() {
        if (!mepCount) return;
        var done = mepItems.filter(function (b) { return b.getAttribute('aria-pressed') === 'true'; }).length;
        var all = done === mepItems.length;
        mepCount.classList.toggle('all', all);
        mepCount.textContent = all ? '✓ ' + T.allReady : done + ' / ' + mepItems.length + ' ' + T.ready;
    }
    mepItems.forEach(function (b) {
        b.addEventListener('click', function () {
            b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
            renderMep();
        });
    });

    /* ---------- minuteurs ---------- */

    var timers = {};
    var ticking = null;

    function fmt(sec) {
        sec = Math.max(0, Math.ceil(sec));
        var h = Math.floor(sec / 3600), m = Math.floor(sec % 3600 / 60), s = sec % 60;
        var mm = (h ? String(m).padStart(2, '0') : String(m)) + ':' + String(s).padStart(2, '0');
        return h ? h + ':' + mm : mm;
    }

    function remaining(tm) {
        return tm.running ? (tm.endAt - Date.now()) / 1000 : tm.left;
    }

    function anyRunning() {
        return Object.keys(timers).some(function (k) { return timers[k].running || timers[k].ringing; });
    }

    function renderTimer(tm) {
        var el = tm.el, r = remaining(tm);
        el.querySelector('.js-clock').textContent = tm.ringing ? T.timerDone : fmt(r);
        el.classList.toggle('running', tm.running);
        el.classList.toggle('ringing', tm.ringing);
        var btn = el.querySelector('.js-timer-toggle');
        var label = tm.ringing ? T.timerStop : tm.running ? T.timerPause : (tm.left < tm.total ? T.timerResume : T.timerStart);
        var icon = tm.ringing ? 'bi-bell' : tm.running ? 'bi-pause-fill' : 'bi-play-fill';
        btn.innerHTML = '<i class="bi ' + icon + '"></i>';
        btn.appendChild(document.createTextNode(label));
        el.querySelector('.js-timer-reset').hidden = tm.running || tm.ringing || tm.left >= tm.total;
    }

    function renderDock() {
        var keys = Object.keys(timers).filter(function (k) { return timers[k].running || timers[k].ringing; });
        // Book ouvert : dans la barre du haut, où rien ne passe dessous. Fermé : en bas de la fiche.
        var dock = book.classList.contains('open') ? dockTop : dockFloat;
        dockTop.innerHTML = '';
        dockFloat.innerHTML = '';
        keys.forEach(function (k) {
            var tm = timers[k];
            // Dans le book, la page de l'étape montre déjà son minuteur : pas de doublon.
            if (book.classList.contains('open') && pages[current] && pages[current].getAttribute('data-step') === tm.step) return;
            var pill = document.createElement('button');
            pill.type = 'button';
            pill.className = 'pb-dock-pill' + (tm.ringing ? ' ringing' : '');
            pill.innerHTML = '<i class="bi ' + (tm.ringing ? 'bi-bell-fill' : 'bi-stopwatch') + '"></i>';
            pill.appendChild(document.createTextNode(T.step + ' ' + tm.step + ' · ' + (tm.ringing ? T.timerDone : fmt(remaining(tm)))));
            pill.addEventListener('click', function () {
                var idx = pages.findIndex(function (p) { return p.getAttribute('data-step') === tm.step; });
                if (!book.classList.contains('open')) open(idx);
                else show(idx);
            });
            dock.appendChild(pill);
        });
    }

    function tick() {
        var ringing = false;
        Object.keys(timers).forEach(function (k) {
            var tm = timers[k];
            if (tm.running && remaining(tm) <= 0) {
                tm.running = false; tm.left = 0; tm.ringing = true;
            }
            if (tm.ringing) ringing = true;
            renderTimer(tm);
        });
        if (ringing) alarm();
        renderDock();
        if (!anyRunning()) { clearInterval(ticking); ticking = null; if (!book.classList.contains('open')) keepAwake(false); }
    }

    function ensureTicking() {
        if (!ticking) ticking = setInterval(tick, 250);
    }

    book.querySelectorAll('[data-timer]').forEach(function (el) {
        var total = parseInt(el.getAttribute('data-seconds'), 10);
        var tm = timers[el.getAttribute('data-timer')] = {
            el: el, total: total, left: total, running: false, ringing: false, endAt: 0,
            step: el.getAttribute('data-page-step')
        };
        el.querySelector('.js-timer-toggle').addEventListener('click', function () {
            unlockAudio();
            if (tm.ringing) { tm.ringing = false; tm.left = tm.total; }
            else if (tm.running) { tm.left = remaining(tm); tm.running = false; }
            else { tm.endAt = Date.now() + tm.left * 1000; tm.running = true; keepAwake(true); ensureTicking(); }
            renderTimer(tm); renderDock();
        });
        el.querySelector('.js-timer-reset').addEventListener('click', function () {
            tm.left = tm.total; tm.running = false; tm.ringing = false;
            renderTimer(tm); renderDock();
        });
        renderTimer(tm);
    });

    // La sonnerie : un bip qui revient tant que personne ne l'a coupée (WebAudio, débloqué au premier « Lancer »).
    var audio = null, lastBeep = 0;
    function unlockAudio() {
        try {
            if (!audio) audio = new (window.AudioContext || window.webkitAudioContext)();
            if (audio.state === 'suspended') audio.resume();
        } catch (e) { audio = null; }
    }
    function alarm() {
        var now = Date.now();
        if (now - lastBeep < 1400) return;
        lastBeep = now;
        if (navigator.vibrate) navigator.vibrate([300, 150, 300]);
        if (!audio) return;
        [0, 0.25, 0.5].forEach(function (d) {
            var o = audio.createOscillator(), g = audio.createGain();
            o.type = 'square'; o.frequency.value = 880;
            g.gain.setValueAtTime(0.0001, audio.currentTime + d);
            g.gain.exponentialRampToValueAtTime(0.35, audio.currentTime + d + 0.02);
            g.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + d + 0.18);
            o.connect(g); g.connect(audio.destination);
            o.start(audio.currentTime + d); o.stop(audio.currentTime + d + 0.2);
        });
    }

    /* ---------- l'écran reste allumé pendant la recette ---------- */

    var lock = null, wantAwake = false;
    function keepAwake(on) {
        wantAwake = on;
        if (!('wakeLock' in navigator)) return;
        if (on && !lock) {
            navigator.wakeLock.request('screen').then(function (l) {
                lock = l;
                l.addEventListener('release', function () { lock = null; });
            }).catch(function () {});
        } else if (!on && lock) {
            lock.release().catch(function () {});
            lock = null;
        }
    }
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') {
            if (wantAwake) keepAwake(true);
            if (anyRunning()) tick();
        }
    });

    /* ---------- départ ---------- */

    applyScale();
    renderMep();
    var start = pageFromHash();
    if (start !== null) open(start);
})();
</script>
