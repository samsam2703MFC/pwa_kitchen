{% extends "layouts/base.twig" %}

{% block title %}{{ translations.orders_title | default("Commandes clients") }}{% endblock %}

{% block head %}
<style>
    .order-status-badge {
        display: inline-block;
        padding: .25rem .65rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
    }
    /* Les statuts gardent leurs couleurs sémantiques — vert pour terminé,
       rouge pour non retiré — mais reprises dans les teintes de la charte
       plutôt que dans les bleus Bootstrap d'origine. */
    .status-new           { background: rgba(31,79,107,.11);  color: #1F4F6B; }
    .status-in_production { background: rgba(193,122,42,.16); color: #8a5a12; }
    .status-completed     { background: rgba(45,122,62,.13);  color: #2D7A3E; }
    .status-picked_up     { background: rgba(45,122,62,.13);  color: #2D7A3E; }
    .status-unpicked      { background: rgba(141,29,44,.11);  color: #8D1D2C; }
    .status-unknown       { background: rgba(36,26,22,.07);   color: #7a7168; }

    .type-badge-b2b        { background: rgba(36,26,22,.07);  color: #7a7168; }
    .type-badge-individual { background: rgba(92,74,138,.12); color: #5C4A8A; }

    .filter-card { border-radius: 12px; }
    .orders-table th { white-space: nowrap; }

    /* ── Bascule du mode de remise ── */
    .ff-seg {
        display: flex; gap: 4px; margin-top: 4px; padding: 4px;
        background: var(--c-bg-2, #F4EFE8);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: 999px;
    }
    /* Le commutateur de Bootstrap fait 19 px de haut : sous le doigt, on
       vise le libellé et on rate la case. On agrandit les deux, qui sont déjà
       liés par « for ». */
    /* Une pastille-bascule, comme les autres filtres de l'app : creuse quand
       elle est éteinte, pleine (encre) et cochée quand elle est active. Bien
       plus nette que l'interrupteur Bootstrap, et une cible large. */
    .ff-toggle {
        display: inline-flex; align-items: center; gap: 9px;
        min-height: 44px; padding: 0 18px; width: 100%;
        border-radius: var(--r-pill, 999px);
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14)); background: #fff;
        font-size: .88rem; font-weight: 600; color: var(--c-muted, #7a7168);
        cursor: pointer; -webkit-tap-highlight-color: transparent;
        transition: background .14s ease, border-color .14s ease, color .14s ease;
    }
    .ff-toggle:active { transform: scale(.99); }
    .ff-toggle:focus { outline: none; }
    .ff-toggle:focus-visible { outline: 3px solid rgba(31,79,107,.35); outline-offset: 2px; }
    .ff-toggle span:last-child, .ff-toggle { white-space: normal; line-height: 1.15; text-align: left; }
    .ff-toggle .ff-tick {
        width: 18px; height: 18px; flex: none; border-radius: 50%;
        border: 2px solid var(--c-line-2, rgba(36,26,22,.2));
        display: grid; place-items: center; font-size: .7rem; color: transparent;
    }
    .ff-toggle[aria-pressed="true"] {
        background: var(--c-encre, #1F4F6B); border-color: var(--c-encre, #1F4F6B); color: #fff;
    }
    .ff-toggle[aria-pressed="true"] .ff-tick {
        background: #fff; border-color: #fff; color: var(--c-encre, #1F4F6B);
    }

    .ff-seg-btn {
        flex: 1; min-height: 44px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 999px; padding: 0 14px;
        font-size: .85rem; font-weight: 600; text-decoration: none;
        color: var(--c-muted, #7a7168); white-space: nowrap;
        transition: background .15s ease, color .15s ease;
    }
    .ff-seg-btn:hover { color: var(--c-ink, #241f1c); }
    .ff-seg-btn.is-active {
        background: var(--c-primary, #8D1D2C); color: #fff;
        box-shadow: 0 6px 14px -8px rgba(141,29,44,.55);
    }
    .ff-seg-note { font-size: .76rem; color: var(--c-muted, #7a7168); margin: 8px 2px 0; }
    .ff-seg-count {
        min-width: 20px; height: 20px; padding: 0 6px; margin-left: 7px;
        border-radius: 999px;
        background: var(--c-secondary, #F2C9A0); color: var(--c-on-abricot, #6b4420);
        font-size: 11px; font-weight: 800; line-height: 20px; text-align: center;
    }
    .ff-seg-count[hidden] { display: none; }
    /* Sur l'onglet actif, le fond est déjà bordeaux : l'abricot y ressort en
       clair plutôt qu'en pastille sombre. */
    .ff-seg-btn.is-active .ff-seg-count { background: rgba(255,255,255,.9); color: var(--c-primary, #8D1D2C); }

    .ff-badge {
        display: inline-flex; align-items: center;
        font-size: .74rem; font-weight: 600;
        border-radius: 999px; padding: 4px 10px; white-space: nowrap;
    }
    .ff-badge-collect  { background: rgba(31,79,107,.11); color: #1F4F6B; }
    .ff-badge-delivery { background: rgba(193,122,42,.16); color: #8a5a12; }
    .value-col { font-variant-numeric: tabular-nums; }
    .initials-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: #e9ecef;
        font-size: .72rem;
        font-weight: 700;
        color: #495057;
    }
</style>
{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.orders_title | default("Commandes clients") }}</h3>
        <p class="text-subtitle text-muted">{{ translations.orders_subtitle | default("Parcourez les commandes clients en attente de traitement.") }}</p>
    </div>
{% endblock %}

{% block content %}

{# ── Formularz filtrów ───────────────────────────────────────────────────── #}
<div class="card filter-card shadow-sm mb-4">
    <div class="card-body">
        <form method="GET" action="{{ ROOT }}/orders" id="ordersFilterForm" class="row g-3 align-items-end">

            {# Data odbioru #}
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label fw-semibold small" for="filterDate">
                    <i class="bi bi-calendar3"></i>
                    {{ translations.filter_date | default("Date de retrait") }}
                </label>
                <input type="date"
                       class="form-control"
                       id="filterDate"
                       name="date"
                       value="{{ date }}"
                >
            </div>

            {# Nazwa klienta #}
            <div class="col-12 col-sm-6 col-lg-4">
                <label class="form-label fw-semibold small" for="filterClientName">
                    <i class="bi bi-person-search"></i>
                    {{ translations.filter_client_name | default('Nazwa klienta') }}
                </label>
                <input type="text"
                       class="form-control"
                       id="filterClientName"
                       name="client_name"
                       value="{{ client_name }}"
                       placeholder="{{ translations.filter_client_name_placeholder | default('Wpisz fragment nazwy...') }}"
                       autocomplete="off"
                >
            </div>

            {# Tylko oczekujące #}
            <div class="col-12 col-sm-6 col-lg-2 d-flex align-items-center gap-2 pt-lg-3">
                {# Ukryte pole — wartość zmieniana przez JS #}
                <input type="hidden" id="pendingOnlyInput" name="pending_only" value="{{ pending_only ? '1' : '0' }}">
                <button type="button" class="ff-toggle" id="filterPendingOnly"
                        aria-pressed="{{ pending_only ? 'true' : 'false' }}">
                    <span class="ff-tick" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    {{ translations.filter_pending_only | default("En attente uniquement") }}
                </button>
            </div>

            {# Przyciski #}
            <div class="col-12 col-sm-6 col-lg-3 d-flex gap-2 align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                    {{ translations.filter_search | default('Szukaj') }}
                </button>
                <a href="{{ ROOT }}/orders" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>

            {# ── Mode de remise ──
               Trois états exclusifs qu'on veut voir tous à la fois pour savoir
               lequel est actif : des onglets segmentés, pas une liste
               déroulante. Ce sont des liens : ils conservent la date et le nom
               de client de l'URL, et fonctionnent sans JavaScript. #}
            <div class="col-12">
                <div class="ff-seg" role="group" aria-label="{{ translations.fulfilment }}">
                    {% set _q = {'date': date, 'client_name': client_name, 'pending_only': pending_only ? '1' : '0'} %}
                    {% for key, label in {
                        'all':      translations.fulfilment_all ?? 'Toutes',
                        'collect':  translations.click_and_collect ?? 'Click & Collect',
                        'delivery': translations.delivery_mode ?? 'Livraison'
                    } %}
                        <a class="ff-seg-btn {{ fulfilment == key ? 'is-active' : '' }}"
                           href="{{ ROOT }}/orders?{{ (_q|merge({'fulfilment': key}))|url_encode }}"
                           aria-current="{{ fulfilment == key ? 'true' : 'false' }}">
                            <span>{{ label }}</span>
                            {# Rempli par le sondage du layout ; abricot, comme la
                               pastille de l'onglet Commandes. #}
                            <span class="ff-seg-count" data-count="{{ key }}" hidden></span>
                        </a>
                    {% endfor %}
                </div>

                {# Un filtre qui ne filtre rien doit le dire. Sans ce mot, il
                   passerait pour cassé. #}
                {% if not has_fulfilment_data %}
                    <p class="ff-seg-note">
                        <i class="bi bi-info-circle"></i>
                        {{ translations.fulfilment_not_served }}
                    </p>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{# ── Tabela zamówień ─────────────────────────────────────────────────────── #}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold">
            <i class="bi bi-list-ul me-1"></i>
            {{ translations.orders | default("Commandes") }}
            —
            <span class="text-primary">{{ date | date('d.m.Y') }}</span>
        </span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary">
                {{ orders | length }} {{ translations.orders_count | default("commandes") }}
            </span>
            <a href="{{ ROOT }}/orders/new" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i>{{ translations.new_order | default("Nouvelle commande") }}
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover orders-table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>{{ translations.col_client | default('Klient') }}</th>
                        <th>{{ translations.col_type | default('Typ') }}</th>
                        <th>{{ translations.fulfilment }}</th>
                        <th>{{ translations.col_pickup | default('Data odbioru') }}</th>
                        <th class="value-col">{{ translations.col_value | default("Valeur") }}</th>
                        <th class="text-center">{{ translations.col_accepted_by | default("Accepté par") }}</th>
                        <th>{{ translations.col_status | default('Status') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% if orders is not empty %}
                        {% for order in orders %}
                        <tr>
                            {# Klient #}
                            <td>
                                <span class="fw-semibold">
                                    {{ order.getClientName() ?? translations.not_available | default('—') }}
                                </span>
                                {% if order.getClientPhone() %}
                                    <div class="text-muted small">
                                        <i class="bi bi-telephone"></i> {{ order.getClientPhone() }}
                                    </div>
                                {% endif %}
                            </td>

                            {# Typ klienta #}
                            <td>
                                {% if order.isB2B() %}
                                    <span class="order-status-badge type-badge-b2b">
                                        <i class="bi bi-building me-1"></i>{{ translations.type_b2b | default('Firma') }}
                                    </span>
                                {% else %}
                                    <span class="order-status-badge type-badge-individual">
                                        <i class="bi bi-person me-1"></i>{{ translations.type_individual | default('Indywidualny') }}
                                    </span>
                                {% endif %}
                            </td>

                            {# Mode de remise #}
                            <td>
                                {% if order.isDelivery() %}
                                    <span class="ff-badge ff-badge-delivery">
                                        <i class="bi bi-truck me-1"></i>{{ translations.delivery_mode }}
                                    </span>
                                {% elseif order.isClickAndCollect() %}
                                    <span class="ff-badge ff-badge-collect">
                                        <i class="bi bi-bag-check me-1"></i>{{ translations.click_and_collect }}
                                    </span>
                                {% else %}
                                    <span class="text-muted">{{ translations.not_available | default('—') }}</span>
                                {% endif %}
                            </td>

                            {# Data i godzina odbioru #}
                            <td>
                                {% if order.getPickUpDatetime() %}
                                    <span class="fw-semibold">{{ order.getPickUpDatetime() | date('H:i') }}</span>
                                    <div class="text-muted small">{{ order.getPickUpDatetime() | date('d.m.Y') }}</div>
                                {% else %}
                                    <span class="text-muted">{{ translations.not_available | default('—') }}</span>
                                {% endif %}
                            </td>

                            {# Wartość #}
                            <td class="value-col">
                                <span class="fw-semibold">
                                    {{ order.getTotalValue() | number_format(2, ',', ' ') }}
                                    {{ constant('APP_CURRENCY_SYMBOL') }}
                                </span>
                            </td>

                            {# Inicjały osoby przyjmującej #}
                            <td class="text-center">
                                {% if order.getAcceptingEmployeeInitials() %}
                                    <span class="initials-badge"
                                          title="{{ order.getAcceptingEmployeeDisplayName() }}">
                                        {{ order.getAcceptingEmployeeInitials() }}
                                    </span>
                                {% else %}
                                    <span class="text-muted">{{ translations.not_available | default('—') }}</span>
                                {% endif %}
                            </td>

                            {# Status #}
                            <td>
                                {% set statusKey = order.getOrderStatus() | lower | default('unknown') %}
                                {% set statusLabel = translations['status_' ~ statusKey] | default(order.getOrderStatus() | capitalize | default('?')) %}
                                <span class="order-status-badge status-{{ statusKey }}">{{ statusLabel }}</span>
                            </td>

                            {# Akcja – szczegóły #}
                            <td>
                                <a href="{{ ROOT }}/orders/{{ order.getId() }}/edit"
                                   class="btn btn-sm btn-outline-secondary me-1"
                                   title="{{ translations.edit_order | default('Edytuj') }}">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a href="{{ ROOT }}/orders/{{ order.getId() }}"
                                   class="btn btn-sm btn-outline-primary"
                                   title="{{ translations.view_details | default("Détails") }}">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                {{ translations.no_orders | default("Aucune commande ne correspond aux critères de recherche.") }}
                                <div class="small mt-1">
                                    {{ translations.no_orders_hint | default('Changez le jour de retrait, ou retirez le filtre sur le nom du client.') }}
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
{# Le layout sonde /ajax/orders/pending-count et diffuse « orders:count » ;
   cet écran n'a qu'à peindre ses propres compteurs. #}
<script>
document.addEventListener('orders:count', function (e) {
    var d = e.detail || {};
    var map = { all: d.total, collect: d.collect, delivery: d.delivery };
    document.querySelectorAll('.ff-seg-count').forEach(function (el) {
        var n = map[el.dataset.count];
        if (typeof n === 'number' && n > 0) {
            el.textContent = n > 99 ? '99+' : n;
            el.hidden = false;
        } else {
            el.hidden = true;
        }
    });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const checkbox        = document.getElementById('filterPendingOnly');
    const hiddenInput     = document.getElementById('pendingOnlyInput');

    checkbox.addEventListener('click', function () {
        const on = this.getAttribute('aria-pressed') !== 'true';
        this.setAttribute('aria-pressed', on ? 'true' : 'false');
        hiddenInput.value = on ? '1' : '0';
    });
});
</script>
{% endblock %}




