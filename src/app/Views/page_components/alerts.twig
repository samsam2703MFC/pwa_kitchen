{# ── Un message peut être une CLÉ de traduction ──
   Les contrôleurs empilaient des phrases toutes faites, en polonais, qui
   arrivaient telles quelles à l'écran quelle que soit la langue réglée sur la
   tablette. Ils poussent maintenant une clé — « error_product_not_found » — et
   c'est ici qu'elle devient une phrase. Une chaîne qui n'est pas une clé
   connue s'affiche telle quelle : les messages venus de l'API, eux, sont déjà
   des phrases. #}
{% set information = information is iterable ? information : (information is empty ? [] : [information]) %}
{% set messages    = messages    is iterable ? messages    : (messages    is empty ? [] : [messages]) %}
{% set warnings    = warnings    is iterable ? warnings    : (warnings    is empty ? [] : [warnings]) %}
{% set errors      = errors      is iterable ? errors      : (errors      is empty ? [] : [errors]) %}

{% set info  = information|default([]) %}
{% set msgs  = messages|default([]) %}
{% set warns = warnings|default([]) %}
{% set errs  = errors|default([]) %}

{# INFO #}
{% if info is iterable and info|length %}
    <div class="row justify-content-center mb-2">
        <div class="col-12 col-md-6">
            {% for it in info %}
                <div class="alert alert-info text-center" role="alert">{{ translations[it] | default(it) }}</div>
            {% endfor %}
        </div>
    </div>
{% endif %}

{# SUCCESS #}
{% if msgs is iterable and msgs|length %}
    <div class="row justify-content-center mb-2">
        <div class="col-12 col-md-6">
            {% for m in msgs %}
                <div class="alert alert-success text-center" role="alert">{{ translations[m] | default(m) }}</div>
            {% endfor %}
        </div>
    </div>
{% endif %}

{# WARNINGS #}
{% if warns is iterable and warns|length %}
    <div class="row justify-content-center mb-2">
        <div class="col-12 col-md-6">
            {% for w in warns %}
                <div class="alert alert-warning text-center" role="alert">{{ translations[w] | default(w) }}</div>
            {% endfor %}
        </div>
    </div>
{% endif %}

{# ERRORS #}
{% if errs is iterable and errs|length %}
    <div class="row justify-content-center mb-2">
        <div class="col-12 col-md-6">
            {% for e in errs %}
                <div class="alert alert-danger text-center" role="alert">{{ translations[e] | default(e) }}</div>
            {% endfor %}
        </div>
    </div>
{% endif %}
