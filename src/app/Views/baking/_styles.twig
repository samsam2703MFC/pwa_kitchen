{# baking/_styles.twig — les styles du planning de production.

   Extraits pour que l'écran Production puisse afficher la frise, les ordres
   et les cartes sans dupliquer trois cents lignes : les deux vues sont un
   seul module derrière un même toggle. Tout est préfixé `bk-`. #}
    /* ── Filtres ─────────────────────────────────────────────────────────
       Un seul rang de pastilles, cibles de 52 px : on filtre d'un pouce,
       sans lever les yeux du four. */
    .bk-filters { display: flex; gap: 8px; flex-wrap: wrap; }
    .bk-f {
        display: inline-flex; align-items: center; gap: 8px;
        min-height: 52px; padding: 0 18px; border-radius: 999px;
        background: #fff; border: 1px solid var(--c-line-2, rgba(36,26,22,.12));
        text-decoration: none; color: var(--c-ink, #241f1c);
        font-weight: 700; font-size: .95rem;
        -webkit-tap-highlight-color: transparent;
    }
    .bk-f .n {
        font-size: .78rem; font-weight: 800; border-radius: 999px; padding: 2px 9px;
        background: var(--c-bg-2, #F4EFE8); color: var(--c-muted, #7a7168);
    }
    .bk-f i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .bk-f.is-on { color: #fff; border-color: transparent; }
    .bk-f.is-on .n { background: rgba(255,255,255,.22); color: #fff; }
    .bk-f.is-on i { background: #fff; }
    .bk-f-all.is-on    { background: var(--c-ink, #241f1c); }
    .bk-f-prep.is-on   { background: #1F4F6B; }
    .bk-f-cook.is-on   { background: #8D1D2C; }
    .bk-f-finish.is-on { background: #C17A2A; }
    .i-prep { background: #1F4F6B; } .i-cook { background: #8D1D2C; } .i-finish { background: #C17A2A; }

    /* Les fours, sous les étapes : subordonnés, comme les catégories sous les
       états dans l'écran Stock. Même grammaire d'un écran à l'autre. */
    .bk-ovens { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 8px; }
    .bk-ovens .cat-chip {
        min-height: 44px; padding: 0 14px; border-radius: 999px;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14)); background: #fff;
        font-family: inherit; font-size: .8rem; font-weight: 600;
        color: var(--c-muted, #7a7168); cursor: pointer; white-space: nowrap;
        -webkit-tap-highlight-color: transparent;
    }
    .bk-ovens .cat-chip.is-on {
        background: var(--c-ink, #241f1c); border-color: var(--c-ink, #241f1c); color: #fff;
    }
    .bk-row[hidden], .bk-card[hidden], .bk-order[hidden] { display: none; }

    /* ── Frise ── */
    .bk-g { position: relative; }
    .bk-ruler { display: flex; margin-left: 190px; padding-bottom: 6px; margin-bottom: 4px;
                border-bottom: 1px solid var(--c-line, rgba(36,26,22,.08)); }
    .bk-ruler div { flex: 1; font-size: .68rem; font-weight: 700; color: var(--c-muted, #7a7168); }
    .bk-row { display: flex; align-items: center; gap: 12px; padding: 4px 0; }
    /* Le retrait de la ligne était le seul signal « pas commencé » ; les
       segments le disent maintenant à 60 %. Cumulés, les deux tombaient à 24 %
       d'opacité et la fournée devenait illisible. */
    .bk-row.is-waiting { opacity: .8; }
    .bk-rowname { width: 178px; flex: 0 0 178px; min-width: 0; }
    .bk-rowname b { display: block; font-size: .84rem; font-weight: 700; line-height: 1.2;
                    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bk-rowname span { display: block; font-size: .68rem; color: var(--c-muted, #7a7168); margin-top: 1px; }
    .bk-track { position: relative; flex: 1; height: 30px; background: #F7F3ED; border-radius: 8px; }
    .bk-track .tick { position: absolute; top: 0; bottom: 0; width: 1px; background: rgba(36,26,22,.06); }
    .bk-seg { position: absolute; top: 5px; height: 20px; }
    .bk-seg.s-prep   { background: #1F4F6B; border-radius: 6px 0 0 6px; }
    .bk-seg.s-cook   { background: #8D1D2C; }
    .bk-seg.s-finish { background: #C17A2A; border-radius: 0 6px 6px 0; }
    /* Coupée au bord gauche : le coin droit reste arrondi, le gauche non — la
       forme dit qu'elle a commencé avant le cadre. Après les trois couleurs
       d'étape : même spécificité, c'est l'ordre qui tranche. */
    .bk-seg.is-clipped { border-top-left-radius: 0; border-bottom-left-radius: 0; }
    /* Prévision ou réalité. Toute la frise est du prévisionnel tant que
       personne n'a validé : à 60 % elle se lit comme une intention, en plein
       comme un fait. La journée se remplit sous les yeux, et ce qui reste pâle
       est exactement ce qui reste à faire. */
    .bk-seg.is-planned { opacity: .6; }
    .bk-seg.is-done    { opacity: 1; }
    /* Hors filtre, l'étape s'efface au lieu de disparaître : la fournée garde
       sa place, et on voit le contexte qui justifie l'horaire. Ça l'emporte
       sur l'opacité de prévision — les deux se cumuleraient sinon. */
    .bk-seg.is-dim { opacity: .16; }
    .bk-shelf.is-planned { opacity: .6; }
    .bk-shelf {
        position: absolute; top: 3px; height: 24px; display: flex; align-items: center; padding: 0 9px;
        border-radius: 999px; background: var(--c-secondary, #F2C9A0); color: var(--c-on-abricot, #4a2c12);
        font-size: .66rem; font-weight: 800; white-space: nowrap;
    }
    .bk-now { position: absolute; top: 22px; bottom: 0; width: 2px; background: var(--c-ink, #241f1c); z-index: 3; }
    .bk-now b { position: absolute; top: -20px; left: 50%; transform: translateX(-50%);
                background: var(--c-ink, #241f1c); color: #fff; font-size: .6rem; font-weight: 800;
                padding: 2px 7px; border-radius: 999px; }
    .bk-legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 12px;
                 font-size: .72rem; color: var(--c-muted, #7a7168); }
    .bk-legend span { display: inline-flex; align-items: center; gap: 6px; }
    .bk-sw { width: 12px; height: 12px; border-radius: 4px; display: inline-block; }
    .bk-legend-sep {
        padding-left: 14px; border-left: 1px solid var(--c-line-2, rgba(36,26,22,.14));
    }
    .bk-sw-planned { background: var(--c-ink, #241f1c); opacity: .6; }
    .bk-sw-done    { background: var(--c-ink, #241f1c); margin-left: 8px; }

    /* ── Ordres ──────────────────────────────────────────────────────────
       Un ordre par ligne, le premier en gros. On ne lit pas une liste ici :
       on lit une phrase, on tape dessus, on retourne au four. */
    .bk-h { font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
            color: var(--c-muted, #7a7168); margin: 0 0 12px; }
    .bk-order {
        display: flex; align-items: center; gap: 14px; width: 100%;
        min-height: 62px; padding: 11px 15px; margin-bottom: 8px;
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-left: 5px solid #d8d2c9; border-radius: var(--r-lg, 18px);
        background: var(--c-surface, #fff); text-align: left; cursor: pointer;
        font-family: inherit; color: var(--c-ink, #241f1c);
        -webkit-tap-highlight-color: transparent;
    }
    .bk-order:last-child { margin-bottom: 0; }
    .bk-order:active { transform: scale(.996); }
    .bk-order.o-prep   { border-left-color: #1F4F6B; }
    .bk-order.o-cook   { border-left-color: #8D1D2C; }
    .bk-order.o-finish { border-left-color: #C17A2A; }
    /* Le premier ordre porte la couleur de son étape en plein : de l'autre
       bout du fournil, on doit voir qu'il y a quelque chose à faire. */
    .bk-order.is-lead { min-height: 84px; color: #fff; border-color: transparent; }
    .bk-order.is-lead.o-prep   { background: #1F4F6B; }
    .bk-order.is-lead.o-cook   { background: #8D1D2C; }
    .bk-order.is-lead.o-finish { background: #C17A2A; }
    .bk-order.is-lead .bk-order-verb { font-size: 1.12rem; }
    .bk-order.is-lead .bk-order-what span,
    .bk-order.is-lead .bk-order-when span { color: rgba(255,255,255,.8); }
    .bk-order.is-lead .bk-order-when b { color: #fff; }
    .bk-order.is-lead .is-late,
    .bk-order.is-lead .is-soon { color: #fff; font-weight: 800; }
    /* Du blanc sur l'abricot passe à peine 3:1 : sur cette couleur-là, c'est
       l'encre qui lit, comme sur les pastilles de mise en rayon. */
    .bk-order.is-lead.o-finish { color: var(--c-on-abricot, #4a2c12); }
    .bk-order.is-lead.o-finish .bk-order-when b,
    .bk-order.is-lead.o-finish .is-late,
    .bk-order.is-lead.o-finish .is-soon { color: var(--c-on-abricot, #4a2c12); }
    .bk-order.is-lead.o-finish .bk-order-what span,
    .bk-order.is-lead.o-finish .bk-order-when span { color: rgba(74,44,18,.78); }

    .bk-order-verb { flex: 0 0 auto; font-size: .92rem; font-weight: 800; line-height: 1.2; max-width: 40%; }
    .bk-order-what { flex: 1; min-width: 0; }
    .bk-order-what b { display: block; font-size: .92rem; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
    .bk-order-what span { display: block; font-size: .72rem; color: var(--c-muted, #7a7168); margin-top: 2px; }
    .bk-order-when { flex: 0 0 auto; text-align: right; }
    .bk-order-when b { display: block; font-size: 1.05rem; font-weight: 800; line-height: 1; }
    .bk-order-when span { display: block; font-size: .7rem; color: var(--c-muted, #7a7168); margin-top: 3px; white-space: nowrap; }
    .bk-order-when .is-late { color: #8D1D2C; font-weight: 800; }
    .bk-order-when .is-soon { color: #C17A2A; font-weight: 800; }
    .bk-more { margin: 10px 0 0; font-size: .74rem; color: var(--c-muted, #7a7168); }

    @media (max-width: 560px) {
        .bk-order { flex-wrap: wrap; gap: 4px 12px; }
        .bk-order-verb { flex: 1 0 100%; max-width: none; }
    }

    /* ── Feuille d'attribution ── */
    .bk-sheet {
        position: fixed; inset: 0; z-index: 1080;
        background: rgba(31,20,16,.45);
        display: flex; align-items: flex-end; justify-content: center;
    }
    .bk-sheet[hidden] { display: none; }
    .bk-sheet-panel {
        display: flex; flex-direction: column; gap: 4px;
        width: 100%; max-width: 620px; max-height: 92vh; overflow-y: auto;
        background: var(--c-bg, #EAE4DC);
        border-radius: var(--r-xl, 24px) var(--r-xl, 24px) 0 0;
        padding: 16px 17px calc(16px + env(safe-area-inset-bottom));
        box-shadow: 0 -12px 40px -18px rgba(0,0,0,.5);
    }
    .bk-sheet-head { display: flex; align-items: center; gap: 12px; }
    .bk-sheet-kicker {
        flex: 1; min-width: 0; margin: 0;
        font-size: .7rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
        color: var(--c-muted, #7a7168);
    }

    /* Le rappel de l'ordre, en grand, juste avant le choix de l'opérateur.
       Entre le tap et la validation il y a deux listes à parcourir et un
       réglage : le temps de choisir un nom, on ne sait plus si on enfournait
       ou si on sortait du four. */
    .bk-recall {
        display: flex; flex-direction: column; gap: 4px;
        margin-top: 10px; padding: 16px 18px;
        border-radius: var(--r-lg, 18px);
        background: var(--c-ink, #241f1c); color: #fff;
    }
    .bk-recall.o-prep   { background: #1F4F6B; }
    .bk-recall.o-cook   { background: #8D1D2C; }
    .bk-recall.o-finish { background: #C17A2A; color: var(--c-on-abricot, #4a2c12); }
    .bk-recall-verb { font-size: 1.5rem; font-weight: 800; line-height: 1.1; }
    .bk-recall-what b { font-size: 1.02rem; font-weight: 700; overflow-wrap: anywhere; }
    .bk-recall-what span { display: block; margin-top: 2px; font-size: .78rem; opacity: .82; }
    @media (max-width: 420px) { .bk-recall-verb { font-size: 1.28rem; } }
    .bk-sheet-x {
        flex: 0 0 auto; width: 40px; height: 40px; padding: 0;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
        border-radius: var(--r-md, 13px); background: #fff;
        color: var(--c-muted, #7a7168); cursor: pointer;
    }
    .bk-sheet-lbl {
        margin: 14px 0 8px; font-size: .7rem; font-weight: 800;
        letter-spacing: .06em; text-transform: uppercase; color: var(--c-muted, #7a7168);
    }
    .bk-sheet-hint { margin: 7px 0 0; font-size: .74rem; color: var(--c-muted, #7a7168); }

    /* Le temps imparti se règle par pas de cinq minutes : en atelier, personne
       ne raisonne à la minute près sur une durée de cuisson. */
    .bk-time { display: flex; align-items: center; gap: 10px; }
    .bk-time-step {
        flex: 0 0 auto; width: 56px; height: 56px; padding: 0;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
        border-radius: var(--r-md, 13px); background: #fff;
        color: var(--c-ink, #241f1c); font-size: 1.5rem; font-weight: 700; line-height: 1;
        cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .bk-time-step:active { background: var(--c-primary-soft, #f4dfe2); }
    .bk-time-val {
        flex: 1; min-height: 56px; display: flex; align-items: center; justify-content: center; gap: 5px;
        border-radius: var(--r-md, 13px); background: #fff;
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        font-size: .85rem; color: var(--c-muted, #7a7168);
    }
    .bk-time-val b { font-size: 1.5rem; font-weight: 800; color: var(--c-ink, #241f1c); }

    .bk-sheet-go {
        display: flex; align-items: center; justify-content: center; gap: 9px;
        width: 100%; min-height: 56px; margin-top: 16px;
        border: 0; border-radius: var(--r-md, 13px);
        background: var(--c-primary, #8D1D2C); color: #fff;
        font-family: inherit; font-size: 1rem; font-weight: 800; cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .bk-sheet-go[disabled] { opacity: .55; cursor: default; }

    /* ── Le second temps : mettre en magasin ─────────────────────────────
       Le rouge est la couleur de la production ; le vert est celui de la mise
       en vente, partout ailleurs dans l'application. Un bouton « En rayon »
       rouge rompait ce lien au seul endroit où il compte le plus. */
    .bk-recall.f-shelf { background: var(--c-vert, #2D7A3E); }
    .bk-sheet-go-shelf { background: var(--c-vert, #2D7A3E); }

    /* Enregistrer et remettre à plus tard ne sont pas deux options de même
       poids : l'une met le produit en vente, l'autre ne fait rien. Deux
       boutons pleins côte à côte le laissaient croire. */
    .bk-sheet-later {
        display: block; width: 100%; margin-top: 10px; padding: 11px 8px;
        border: 0; background: none;
        color: var(--c-muted, #7a7168);
        font-family: inherit; font-size: .84rem; font-weight: 700;
        cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    /* Le soulignement ne porte que sur le libellé : posé sur le bouton, il
       barrerait aussi la conséquence — qui n'est pas cliquable et passerait
       pour un second lien. Une décoration ne se retire pas sur un descendant. */
    .bk-later-lbl { text-decoration: underline; text-underline-offset: 3px; }
    .bk-sheet-later small {
        display: block; margin-top: 3px; font-size: .72rem; font-weight: 500;
        opacity: .8;
    }

    /* ── La réserve ──────────────────────────────────────────────────────
       Une fournée gardée en réserve n'est pas en vente, et rien ailleurs ne le
       rappelle : la fournée est terminée, elle a donc quitté la frise et les
       ordres. Sans cette bande, « plus tard » voulait dire « jamais ». */
    .bk-reserve {
        background: #fff;
        border: 1px solid var(--c-vert, #2D7A3E);
        border-left: 4px solid var(--c-vert, #2D7A3E);
        border-radius: var(--r-lg, 18px); padding: 13px 15px; margin-bottom: 14px;
    }
    .bk-reserve[hidden] { display: none; }
    .bk-reserve-t {
        margin: 0 0 9px; font-size: .72rem; font-weight: 800;
        letter-spacing: .06em; text-transform: uppercase; color: var(--c-vert, #2D7A3E);
    }
    .bk-reserve-row {
        display: flex; align-items: center; gap: 11px;
        padding: 8px 0; border-top: 1px solid var(--c-line, rgba(36,26,22,.07));
    }
    .bk-reserve-row:first-of-type { border-top: 0; }
    .bk-reserve-x { flex: 1; min-width: 0; }
    .bk-reserve-x b { display: block; font-size: .92rem; font-weight: 700; overflow-wrap: anywhere; }
    .bk-reserve-x small { display: block; margin-top: 1px; font-size: .72rem; color: var(--c-muted, #7a7168); }
    .bk-reserve-go {
        flex: 0 0 auto; min-height: 44px; padding: 0 15px;
        display: inline-flex; align-items: center; gap: 7px;
        border: 0; border-radius: var(--r-md, 13px);
        background: var(--c-vert, #2D7A3E); color: #fff;
        font-family: inherit; font-size: .85rem; font-weight: 800;
        cursor: pointer; -webkit-tap-highlight-color: transparent;
    }

    /* Badges d'employés : mêmes que ceux des checklists, à dessein — c'est le
       même geste, « je dis qui l'a fait ». */
    .emp-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 9px; }
    .emp-badge {
        display: flex; align-items: center; gap: 10px;
        min-height: 52px; padding: 8px 12px;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
        border-radius: var(--r-md, 13px);
        background: #fff; cursor: pointer; text-align: left; font-family: inherit;
        -webkit-tap-highlight-color: transparent;
    }
    .emp-badge.is-active { border-color: var(--c-primary, #8D1D2C); background: var(--c-primary-soft, #f4dfe2); }
    .emp-initials {
        width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: var(--c-primary, #8D1D2C); color: #fff;
        font-family: var(--font-display); font-size: .8rem; line-height: 1;
    }
    .emp-name { flex: 1; min-width: 0; font-size: .88rem; font-weight: 600;
                color: var(--c-ink, #241f1c); line-height: 1.25; overflow-wrap: anywhere; }
    .emp-note { font-size: .78rem; color: var(--c-muted, #7a7168); margin: 9px 0 0; }

    /* ── Cartes ── */
    /* Une fournée par rangée. Deux colonnes tenaient plus de cartes à l'écran,
       mais on ne lit pas cet écran de haut en bas : on cherche UNE fournée, et
       en deux colonnes l'œil doit balayer en zigzag. Une seule colonne se
       parcourt d'un doigt, et le bouton d'action reste à la même abscisse. */
    .bk-list { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }
    .bk-card {
        background: var(--c-surface, #fff); border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-left: 5px solid #d8d2c9; border-radius: var(--r-lg, 18px);
        padding: 15px 17px; box-shadow: var(--sh-1, 0 1px 2px rgba(0,0,0,.04));
    }
    .bk-card.k-prep   { border-left-color: #1F4F6B; }
    .bk-card.k-cook   { border-left-color: #8D1D2C; }
    .bk-card.k-finish { border-left-color: #C17A2A; }
    .bk-card.is-waiting { opacity: .62; }
    /* Arrivée depuis une tuile de Production : la fournée visée se signale au
       lieu de se laisser chercher. Un anneau, pas une couleur — le liseré de
       gauche dit déjà l'étape, et deux signaux de couleur se contrediraient. */
    .bk-card.is-focus {
        box-shadow: 0 0 0 3px var(--c-secondary, #F2C9A0), var(--sh-2, 0 6px 18px -10px rgba(0,0,0,.3));
        border-color: var(--c-secondary, #F2C9A0);
        animation: bk-found 1.6s ease-out 1;
    }
    /* Deux battements, puis plus rien : le temps que l'œil arrive, pas plus.
       Une animation qui tourne en boucle devant un four finit par se voir
       davantage que la fournée. */
    @keyframes bk-found {
        0%, 100% { box-shadow: 0 0 0 3px var(--c-secondary, #F2C9A0), var(--sh-2, 0 6px 18px -10px rgba(0,0,0,.3)); }
        35%      { box-shadow: 0 0 0 8px rgba(242,201,160,.45), var(--sh-2, 0 6px 18px -10px rgba(0,0,0,.3)); }
    }
    @media (prefers-reduced-motion: reduce) {
        .bk-card.is-focus { animation: none; }
    }
    .bk-row.is-focus { opacity: 1; }
    .bk-row.is-focus .bk-rowname b { text-decoration: underline; text-underline-offset: 3px; }

    .bk-top { display: flex; align-items: flex-start; gap: 12px; }
    .bk-name { flex: 1; min-width: 0; }
    .bk-name b { display: block; font-size: 1.1rem; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
    .bk-name span { display: block; font-size: .76rem; color: var(--c-muted, #7a7168); margin-top: 3px; }
    .bk-qty { flex: 0 0 auto; text-align: right; }
    .bk-qty b { display: block; font-size: 1.45rem; font-weight: 800; line-height: 1; }
    .bk-qty span { display: block; font-size: .62rem; text-transform: uppercase; letter-spacing: .05em;
                   color: var(--c-muted, #7a7168); margin-top: 2px; }

    /* Trois pastilles, une seule allumée : on situe la fournée dans son cycle
       sans lire une seule heure. */
    .bk-steps { display: flex; gap: 6px; margin-top: 12px; }
    .bk-st {
        flex: 1; min-height: 40px; border-radius: 11px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        background: var(--c-bg-2, #F4EFE8); color: #b3aaa0; font-size: .73rem; font-weight: 700;
    }
    .bk-st em { font-style: normal; font-size: .61rem; font-weight: 700; opacity: .9; }
    .bk-st.is-done { color: #8d8479; background: #e9e2d8; }
    .bk-st.is-done .ok { color: #2D7A3E; font-weight: 800; }
    .bk-st.is-on { color: #fff; }
    .bk-st.is-on.p-prep   { background: #1F4F6B; }
    .bk-st.is-on.p-cook   { background: #8D1D2C; }
    .bk-st.is-on.p-finish { background: #C17A2A; }

    .bk-when { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 11px; }
    .bk-when .l { font-size: .83rem; color: var(--c-muted, #7a7168); }
    .bk-when .l b { color: var(--c-ink, #241f1c); font-weight: 800; }
    .bk-when .r { font-size: .77rem; color: var(--c-muted, #7a7168); }
    .bk-when .r b { color: #2D7A3E; font-weight: 800; }

    .bk-prog { height: 6px; border-radius: 3px; background: #ece5da; overflow: hidden; margin-top: 8px; }
    .bk-prog > i { display: block; height: 100%; border-radius: 3px; }
    .k-prep .bk-prog > i   { background: #1F4F6B; }
    .k-cook .bk-prog > i   { background: #8D1D2C; }
    .k-finish .bk-prog > i { background: #C17A2A; }

    .bk-act {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; min-height: 52px; margin-top: 12px; border: 0; border-radius: var(--r-md, 13px);
        font-family: inherit; font-size: .97rem; font-weight: 800; cursor: pointer; color: #fff;
        -webkit-tap-highlight-color: transparent;
    }
    .bk-act:active { transform: scale(.995); }
    .bk-act[disabled] { opacity: .55; cursor: default; }
    .a-prep   { background: #1F4F6B; } .a-prep:hover   { background: #173d53; color: #fff; }
    .a-cook   { background: #8D1D2C; } .a-cook:hover   { background: #74101f; color: #fff; }
    .a-finish { background: #C17A2A; } .a-finish:hover { background: #a56420; color: #fff; }
    .a-wait { background: #fff; color: var(--c-muted, #7a7168);
              border: 1px dashed var(--c-line-2, rgba(36,26,22,.2)); font-weight: 700; }

    .bk-tag { display: inline-block; border-radius: 999px; padding: 2px 9px;
              font-size: .66rem; font-weight: 800; margin-left: 6px; }
    .bk-tag-piece { background: #dff0e4; color: #1d5a2c; }
    .bk-tag-lot   { background: #EFE9E1; color: #6b6259; }

    .bk-state { text-align: center; padding: 36px 22px; }
    .bk-state .lc-icon { color: var(--c-muted, #7a7168); opacity: .45; }
    .bk-state p { margin: 13px auto 0; max-width: 48ch; color: var(--c-muted, #7a7168); line-height: 1.6; }

    @media (max-width: 820px) {
        .bk-rowname { width: 124px; flex-basis: 124px; }
        .bk-ruler { margin-left: 136px; }
    }

    /* ── Le fil de production — mode service ─────────────────────────────
       Une ligne par fournée, trois états, un geste. On n'est plus en train de
       consulter : le Gantt et le panneau d'ordres disaient où en était la
       journée, le fil dit quoi faire maintenant, fournée par fournée.

       Trois codes redondants portent la même information — la pastille, la
       couleur, le verbe. À trois mètres du four on lit la couleur, à un mètre
       on lit le mot. */
    .fil { margin-top: 10px; }
    .f-row {
        display: grid; align-items: center; gap: 14px;
        grid-template-columns: minmax(160px, 1.3fr) minmax(272px, 1.8fr) 56px auto;
        background: var(--c-surface, #fff);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-left: 5px solid var(--c-line-2, rgba(36,26,22,.15));
        border-radius: var(--r-lg, 18px); padding: 12px 16px; margin-bottom: 8px;
    }
    .f-row.k-prep   { border-left-color: #1F4F6B; }
    .f-row.k-cook   { border-left-color: #8D1D2C; }
    .f-row.k-finish { border-left-color: #C17A2A; }
    .f-row.is-focus { box-shadow: 0 0 0 2px var(--c-secondary, #F2C9A0); }
    .f-row[hidden] { display: none; }

    .f-id { min-width: 0; }
    /* Le nom passe à la ligne plutôt que de se couper : « Chausson aux p… » et
       « Chausson aux pommes » se ressemblent trop pour qu'on choisisse la
       fournée sur cette base, et c'est le seul mot qui identifie la ligne. */
    .f-id b {
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        font-size: 1.02rem; font-weight: 800; line-height: 1.15;
        overflow: hidden; overflow-wrap: anywhere;
    }
    .f-id small { display: block; margin-top: 2px; font-size: .74rem; color: var(--c-muted, #7a7168); }

    /* Le fil : trois jalons reliés, celui en cours allumé et grossi. */
    .f-fil { display: flex; align-items: center; }
    .f-st {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        flex: 0 0 auto; width: 78px;
    }
    .f-st i {
        width: 30px; height: 30px; border-radius: 50%; font-style: normal;
        display: flex; align-items: center; justify-content: center;
        background: var(--c-bg-2, #F4EFE8); color: #b8b0a6;
        font-size: .8rem; font-weight: 800;
    }
    .f-st em { font-style: normal; font-size: .66rem; font-weight: 700; color: #b8b0a6; }
    .f-st u  { text-decoration: none; font-size: .64rem; color: #c9c1b7; font-variant-numeric: tabular-nums; }
    .f-st.is-done i  { background: var(--c-vert, #2D7A3E); color: #fff; }
    .f-st.is-done em { color: var(--c-muted, #7a7168); }
    .f-st.is-done u  { color: #b8b0a6; }
    .f-st.is-on i    { background: var(--c-ink, #241f1c); color: #fff; transform: scale(1.12); }
    .f-st.is-on em   { color: var(--c-ink, #241f1c); font-weight: 800; }
    .f-st.is-on u    { color: var(--c-muted, #7a7168); font-weight: 700; }
    .k-prep   .f-st.is-on i { background: #1F4F6B; }
    .k-cook   .f-st.is-on i { background: #8D1D2C; }
    .k-finish .f-st.is-on i { background: #C17A2A; }
    .f-link { flex: 1 1 auto; height: 3px; border-radius: 2px; background: #EDE6DC; margin: 0 -6px 22px; }

    .f-eta { text-align: right; line-height: 1.1; }
    .f-eta b { display: block; font-size: 1rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .f-eta small {
        font-size: .58rem; font-weight: 800; letter-spacing: .06em;
        text-transform: uppercase; color: var(--c-muted, #7a7168);
    }

    /* Le geste : une seule cible, large, à la même place sur chaque ligne. */
    .f-go { display: flex; flex-direction: column; align-items: stretch; gap: 3px; }
    .f-btn {
        min-height: 56px; min-width: 172px; padding: 0 20px;
        border: 0; border-radius: var(--r-md, 13px);
        background: var(--c-ink, #241f1c); color: #fff;
        font-family: inherit; font-size: .95rem; font-weight: 800; cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .f-btn:active { transform: scale(.995); }
    .k-prep   .f-btn { background: #1F4F6B; }
    .k-cook   .f-btn { background: #8D1D2C; }
    .k-finish .f-btn { background: #C17A2A; }
    /* La dernière étape ouvre la mise en magasin : on l'annonce avant le tap. */
    .f-then {
        text-align: center; font-size: .64rem; font-weight: 800;
        letter-spacing: .04em; color: var(--c-vert, #2D7A3E);
    }
    .f-wait {
        display: block; text-align: right; font-size: .76rem;
        color: var(--c-muted, #7a7168); font-style: italic;
    }

    /* Écran étroit : le fil descend sous le nom, le bouton prend la largeur. */
    @media (max-width: 780px) {
        .f-row { grid-template-columns: 1fr auto; gap: 8px 12px; padding: 12px 14px; }
        .f-fil { grid-column: 1 / -1; order: 3; }
        .f-eta { order: 2; }
        .f-go  { grid-column: 1 / -1; order: 4; }
        .f-btn { width: 100%; min-width: 0; }
        .f-st  { width: auto; flex: 1 1 0; }
    }
